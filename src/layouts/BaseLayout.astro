---
import "../styles/globals.css";
import SeoHead from "../components/SeoHead.astro";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
};

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  image,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SeoHead title={title} description={description} image={image} noindex={noindex} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="overflow-x-clip">
      <slot />
    </div>
  </body>
</html>
