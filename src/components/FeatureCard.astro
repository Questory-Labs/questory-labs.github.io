---
import HatchShadow from "./HatchShadow.astro";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<HatchShadow size="sm" class="h-full">
  <div class="panel h-full p-5">
    <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--ink)]">
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{description}</p>
  </div>
</HatchShadow>
