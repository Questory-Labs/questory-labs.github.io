---
import { GITHUB_URL, LICENSE_URL, SELF_HOST_PATH } from "../data/features";
import { SCREENSHOTS_PATH } from "../data/site";
---

<footer class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-[var(--line)] px-4 pb-10 pt-6 text-[13px] text-[var(--faint)]">
  <p class="m-0">
    Required Notice: Copyright Questory Labs (<a
      href={GITHUB_URL}
      class="text-[var(--muted-strong)] underline-offset-4 hover:underline"
      target="_blank"
      rel="noopener noreferrer">Questory-Labs/Questory</a
    >) · PolyForm Noncommercial 1.0.0
  </p>
  <p class="font-serif m-0 text-base">play. listen. watch. read. questory</p>
  <nav class="flex flex-wrap gap-4" aria-label="Footer">
    <a href={SCREENSHOTS_PATH} class="text-[var(--muted-strong)] hover:text-[var(--ink)]">Screenshots</a>
    <a href={SELF_HOST_PATH} class="text-[var(--muted-strong)] hover:text-[var(--ink)]">Self-hosting</a>
    <a href={LICENSE_URL} class="text-[var(--muted-strong)] hover:text-[var(--ink)]" target="_blank" rel="noopener noreferrer">License</a>
    <a href={GITHUB_URL} class="text-[var(--muted-strong)] hover:text-[var(--ink)]" target="_blank" rel="noopener noreferrer">GitHub</a>
  </nav>
</footer>
