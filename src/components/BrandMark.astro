---
type Props = {
  href?: string | null;
  size?: "sm" | "md" | "lg";
  showWordmark?: boolean;
  class?: string;
  wordmarkClass?: string;
};

const {
  href = "/",
  size = "md",
  showWordmark = true,
  class: className = "",
  wordmarkClass = "",
} = Astro.props;

const sizes = { sm: 20, md: 28, lg: 56 } as const;
const px = sizes[size];
const Tag = href == null ? "span" : "a";
---

<Tag
  href={href ?? undefined}
  aria-label={href == null ? undefined : "Questory home"}
  class:list={["inline-flex items-center gap-2 text-[var(--ink)]", className]}
>
  <img src="/favicon.svg" alt="" width={px} height={px} class="shrink-0 rounded-[20%]" decoding="async" />
  {
    showWordmark ? (
      <span class:list={["text-base font-medium leading-none tracking-[-0.02em]", wordmarkClass]}>questory</span>
    ) : (
      <span class="sr-only">Questory</span>
    )
  }
</Tag>
