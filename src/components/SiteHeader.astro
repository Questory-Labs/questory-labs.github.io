---
import BrandMark from "./BrandMark.astro";
import { GITHUB_URL, SELF_HOST_PATH } from "../data/features";
import { SCREENSHOTS_PATH } from "../data/site";

const path = Astro.url.pathname;
const isHome = path === "/";

const links = [
  { href: isHome ? "#modules" : "/#modules", label: "Modules", active: false },
  { href: isHome ? "#qengine" : "/#qengine", label: "QEngine", active: false },
  { href: SELF_HOST_PATH, label: "Self-host", active: path.startsWith(SELF_HOST_PATH) },
  { href: SCREENSHOTS_PATH, label: "Screenshots", active: path.startsWith(SCREENSHOTS_PATH) },
];
---

<header class="q-nav">
  <nav aria-label="Site" class="q-nav-pill q-in">
    <BrandMark size="sm" class="mr-2.5" />
    {
      links.map((link) => (
        <a href={link.href} class="q-nav-link" aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="q-btn q-btn-nav">GitHub</a>
  </nav>
</header>
