---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SplitText from "../components/SplitText.astro";
import { gameFeatures, mediaGroups, GITHUB_URL, SELF_HOST_PATH } from "../data/features";
import { SCREENSHOTS_PATH } from "../data/site";

const full = (id: string) => `/screenshots/full/${id}.webp`;

const playShots: Record<string, string> = {
  Dashboard: "steam-dashboard",
  Wishlist: "steam-wishlist",
  "Multiplayer planner": "steam-multiplayer",
  "Cost analytics": "steam-cost",
};
const playPanels = gameFeatures
  .filter((f) => f.title in playShots)
  .map((f, i) => ({ ...f, n: String(i + 1).padStart(2, "0"), shot: playShots[f.title] }));
const shelf = gameFeatures.filter((f) => !(f.title in playShots));
const shelfPaths: Record<string, string> = {
  Library: "/library",
  Collections: "/collections",
  Friends: "/friends",
  "Family insights": "/family",
  Trending: "/trending",
  Search: "/search",
};

const moduleMeta: Record<string, { tag: string; title: string; sources: string[]; shot: string; tint: string }> = {
  music: {
    tag: "ListenBrainz · multi-scrobbler",
    title: "Hear your year take shape.",
    sources: ["ListenBrainz", "Spotify", "Last.fm", "multi-scrobbler"],
    shot: "music-dashboard",
    tint: "var(--accent)",
  },
  watch: {
    tag: "Movies · TV · Anime",
    title: "Every episode, accounted for.",
    sources: ["Trakt", "Letterboxd", "AniList", "MAL", "Plex / Jellyfin"],
    shot: "watch-dashboard",
    tint: "var(--warm)",
  },
  read: {
    tag: "Manga · Manhwa · Novels",
    title: "Chapters, logged.",
    sources: ["AniList", "MAL", "Kitsu", "Bangumi", "Shikimori"],
    shot: "read-dashboard",
    tint: "var(--rose)",
  },
};
const modules = mediaGroups.map((group, i) => ({
  ...moduleMeta[group.id],
  label: group.eyebrow,
  n: String(i + 1).padStart(2, "0"),
  body: `${group.features[0].description} ${group.features[1].description}`,
}));

const highlight = new Set(["actually", "read", "play,", "skip,", "next,", "tonight."]);
const manifesto =
  "Questory turns the wall of games you bought on sale into something you can actually read — what you play, what you skip, what's worth buying next, and who's free tonight."
    .split(" ")
    .map((word) => ({ word, hl: highlight.has(word) }));

const marqueeItems = ["Dashboard", "Wishlist", "Collections", "Friends", "Music", "Watch", "Read", "QEngine"];

const chips = [
  { cls: "qs-chip-a left-[-28px] top-[18%]", label: "Should-buy score", sub: "Steam · Epic · GOG", tone: "accent", icon: "tag" },
  { cls: "qs-chip-b right-[-24px] top-[8%]", label: "Cost per hour", sub: "From store prices", tone: "warm", icon: "clock" },
  { cls: "qs-chip-c right-[6%] bottom-[-26px]", label: "Strict library match", sub: "Multiplayer planner", tone: "accent", icon: "people" },
];

const arrowUpRight = `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>`;
---

<BaseLayout>
  <SiteHeader />
  <main id="top">
    <!-- Hero -->
    <section class="qs-hero mx-auto max-w-[1240px] px-4 pb-10 pt-16 text-center sm:px-6 md:pt-28 lg:px-10">
      <div class="qs-hero-copy">
        <p class="qs-pill inline-flex items-center gap-2.5 rounded-full border border-[var(--line-strong)] bg-[var(--surface)] px-3.5 py-2 font-mono text-xs uppercase tracking-[0.08em] text-[var(--muted-strong)]">
          <span class="size-[7px] rounded-full bg-[var(--accent)] shadow-[0_0_0_4px_rgba(125,211,192,0.18)]"></span>
          Steam-first library &amp; media intelligence
        </p>
        <h1 class="font-display mx-auto mt-7 max-w-[1080px] text-[clamp(52px,10vw,148px)] font-extrabold leading-[0.92] tracking-[-0.045em]">
          <SplitText lines={[{ text: "Your library," }, { text: "decoded.", class: "text-[var(--accent)]" }]} />
        </h1>
        <p class="qs-hero-sub mx-auto mt-7 max-w-[620px] text-[clamp(17px,1.6vw,21px)] leading-relaxed text-[var(--muted)]">
          Play, listen, and watch — weekly insights across your Steam library, music, and media. Self-hosted, on your own hardware.
        </p>
        <div class="qs-hero-cta mt-10 flex flex-wrap justify-center gap-3.5">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="qs-mag qs-btn-primary inline-flex min-h-[54px] items-center gap-2.5 rounded-[10px] bg-[var(--accent)] px-7 font-semibold text-[var(--bg-0)]">
            View on GitHub <Fragment set:html={arrowUpRight} />
          </a>
          <a href={SELF_HOST_PATH} class="qs-mag qs-btn-ghost inline-flex min-h-[54px] items-center rounded-[10px] border border-[var(--line-strong)] bg-[var(--bg-1)] px-7 font-semibold">
            Self-host guide
          </a>
        </div>
      </div>

      <div class="qs-hero-scale relative mx-auto mt-14 max-w-[1120px] md:mt-24">
        {
          chips.map((chip) => (
            <div class:list={["qs-chip absolute z-[3] hidden md:block", chip.cls]}>
              <div class="qs-chip-in flex items-center gap-2.5 rounded-xl border border-[var(--line-strong)] bg-[var(--chip)] px-4 py-3 text-left text-sm font-semibold shadow-[0_20px_40px_rgba(0,0,0,0.45)]">
                <span class:list={["grid size-[30px] place-items-center rounded-lg", chip.tone === "warm" ? "bg-[rgba(224,184,106,0.16)] text-[var(--warm)]" : "bg-[var(--accent-dim)] text-[var(--accent)]"]}>
                  {chip.icon === "tag" && (
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
                  )}
                  {chip.icon === "clock" && (
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  )}
                  {chip.icon === "people" && (
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"></circle><circle cx="17" cy="9" r="2.6"></circle><path d="M3 19c.8-3 3.2-4.6 6-4.6s5.2 1.6 6 4.6"></path><path d="M15.5 14.6c2.6 0 4.6 1.4 5.5 4.4"></path></svg>
                  )}
                </span>
                <span>
                  {chip.label}
                  <br />
                  <span class="text-xs font-normal text-[var(--muted)]">{chip.sub}</span>
                </span>
              </div>
            </div>
          ))
        }
        <div class="qs-hero-shot">
          <div class="hatch" data-tilt>
            <div class="qs-frame shadow-[0_50px_120px_rgba(0,0,0,0.55)]">
              <div aria-hidden="true" class="flex items-center gap-[7px] border-b border-[var(--line)] bg-[var(--paper)] px-4 py-3">
                <span class="size-2.5 rounded-full bg-[#3a3a42]"></span>
                <span class="size-2.5 rounded-full bg-[#3a3a42]"></span>
                <span class="size-2.5 rounded-full bg-[#3a3a42]"></span>
                <span class="ml-3.5 font-mono text-xs text-[var(--muted)]">questory.local / dashboard</span>
              </div>
              <img src={full("steam-dashboard")} alt="Questory dashboard showing playtime, backlog, play-next picks and deal signals" width="1440" height="900" class="h-auto w-full" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <section class="qs-marquee-wrap mt-20 overflow-hidden border-y border-[var(--line)] bg-[#121215] py-7 md:mt-28" aria-label="Everything Questory tracks">
      <div class="qs-marquee font-display whitespace-nowrap text-[clamp(34px,5vw,68px)] font-extrabold tracking-[-0.035em]">
        {
          [false, true].map((dup) => (
            <div class="flex items-center gap-11 pr-11" aria-hidden={dup ? "true" : undefined}>
              {marqueeItems.map((item, i) => (
                <>
                  <span class:list={[i % 2 === 1 && "qs-ghost"]}>{item}</span>
                  <span class={i % 2 === 0 ? "text-[var(--accent)]" : "text-[var(--warm)]"} aria-hidden="true">✦</span>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Manifesto -->
    <section class="qs-manifesto mx-auto max-w-[1240px] px-4 py-24 sm:px-6 md:py-44 lg:px-10">
      <p class="font-mono text-[13px] uppercase tracking-[0.12em] text-[var(--muted)]">Why Questory</p>
      <p class="font-display mt-7 text-[clamp(32px,4.6vw,66px)] font-bold leading-[1.08] tracking-[-0.03em]">
        {manifesto.map(({ word, hl }) => <><span class:list={["qs-w", hl && "text-[var(--accent)]"]}>{word}</span>{" "}</>)}
      </p>
    </section>

    <!-- Play: pinned horizontal gallery -->
    <section id="play" class="qs-hwrap">
      <div class="qs-htrack">
        <div class="qs-hpanel qs-hpanel-intro">
          <p class="qs-eyebrow">01 — Play</p>
          <h2 class="font-display mt-4 text-[clamp(44px,5.6vw,84px)] font-extrabold leading-[0.96] tracking-[-0.045em]">Every hour,<br />every dollar,<br />every friend.</h2>
          <p class="mt-6 max-w-[440px] text-lg leading-relaxed text-[var(--muted)]">
            Core Steam features — dashboard, wishlist, collections, cost analytics, friends, and more — in one self-hosted app.
          </p>
          <p class="mt-9 hidden items-center gap-3 font-mono text-xs uppercase tracking-[0.1em] text-[var(--muted)] md:flex">
            Keep scrolling
            <svg aria-hidden="true" width="40" height="12" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6h37"></path><path d="m33 1 5 5-5 5"></path></svg>
          </p>
        </div>
        {
          playPanels.map((panel) => (
            <article class="qs-hpanel">
              <div class="hatch">
                <div class="qs-frame qs-hframe">
                  <img src={full(panel.shot)} alt={`${panel.title} view`} width="1440" height="900" loading="lazy" />
                </div>
              </div>
              <div class="qs-hcopy mt-5 flex flex-wrap items-baseline gap-x-8 gap-y-5">
                <span class="qs-ghost font-display text-[56px] font-extrabold leading-none">{panel.n}</span>
                <h3 class="font-display text-[32px] font-bold tracking-[-0.02em]">{panel.title}</h3>
                <p class="min-w-0 flex-[1_1_280px] text-[17px] leading-relaxed text-[var(--muted)]">{panel.description}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="mx-auto mt-9 hidden h-0.5 w-[min(420px,60vw)] overflow-hidden rounded bg-[var(--line)] md:block" aria-hidden="true">
        <div class="qs-hbar h-full origin-left scale-x-0 bg-[var(--accent)]"></div>
      </div>
    </section>

    <!-- Rest of the shelf -->
    <section class="mx-auto max-w-[1240px] px-4 py-24 sm:px-6 md:py-40 lg:px-10">
      <h2 class="qs-up font-display max-w-[760px] text-[clamp(38px,4.6vw,64px)] font-extrabold leading-none tracking-[-0.04em]">And the rest<br />of the shelf.</h2>
      <div class="qs-shelf-grid mt-14 grid gap-[22px] [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))]">
        {
          shelf.map((feature, i) => (
            <div class="qs-cardw hatch hatch-sm">
              <div class="h-full rounded-xl border border-[var(--line)] bg-[var(--bg-1)] p-7">
                <p class:list={["font-mono text-xs", i < 3 ? "text-[var(--accent)]" : "text-[var(--warm)]"]}>{shelfPaths[feature.title] ?? ""}</p>
                <h3 class="font-display mb-2 mt-3.5 text-2xl font-bold">{feature.title}</h3>
                <p class="leading-relaxed text-[var(--muted)]">{feature.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Modules: pinned stacking cards -->
    <section id="modules" class="border-t border-[var(--line)] bg-[var(--panel)]">
      <div class="qs-modpin mx-auto max-w-[1240px] px-4 pb-10 sm:px-6 lg:px-10">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-x-12 gap-y-4 pt-12">
          <div class="min-w-0 flex-[1_1_480px]">
            <p class="qs-eyebrow">02 — Optional modules</p>
            <h2 class="font-display mt-3.5 text-[clamp(36px,4.4vw,60px)] font-extrabold leading-[0.98] tracking-[-0.04em]">Listen. Watch. Read.</h2>
          </div>
          <p class="max-w-[400px] flex-[1_1_300px] text-[17px] leading-relaxed text-[var(--muted)]">
            Turn them on when you self-host — same account, same database, feature-flagged in the UI.
          </p>
        </div>
        <div class="qs-stack">
          {
            modules.map((mod, i) => (
              <article
                class="qs-mpanel rounded-[22px] border bg-[#18181c] p-[clamp(18px,2.4vw,28px)] shadow-[0_-20px_60px_rgba(0,0,0,0.45)]"
                style={`border-color: color-mix(in srgb, ${mod.tint} 35%, transparent); z-index: ${i + 1}`}
              >
                <div class="min-w-0 flex-[1_1_340px] p-[clamp(8px,1.5vw,16px)]">
                  <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.1em] text-[var(--muted)]">
                    <span class="inline-grid h-6 min-w-[34px] place-items-center rounded-md px-2 font-medium text-[var(--bg-0)]" style={`background: ${mod.tint}`}>{mod.n}</span>
                    {mod.tag}
                  </p>
                  <h3 class="font-display mt-5 text-[clamp(36px,4vw,58px)] font-extrabold leading-[0.98] tracking-[-0.04em]">{mod.label}</h3>
                  <p class="font-display mt-2.5 text-[clamp(20px,1.8vw,26px)] font-semibold tracking-[-0.02em] text-[#d8d3ca]">{mod.title}</p>
                  <p class="mt-4 leading-relaxed text-[var(--muted)]">{mod.body}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {mod.sources.map((source) => (
                      <span class="rounded-full border border-[var(--line-strong)] bg-[var(--surface)] px-3 py-1.5 text-[13px]">{source}</span>
                    ))}
                  </div>
                </div>
                <div class="qs-mmedia min-w-0 flex-[1.5_1_520px]">
                  <div class="qs-frame !rounded-[14px] !bg-[var(--bg-0)]">
                    <img src={full(mod.shot)} alt={`${mod.label} dashboard`} width="1440" height="900" loading="lazy" class="h-auto w-full" />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- QEngine -->
    <section id="qengine" class="qs-qengine mx-auto flex max-w-[1240px] flex-wrap-reverse items-center gap-[clamp(40px,6vw,80px)] px-4 py-24 sm:px-6 md:py-44 lg:px-10">
      <div class="min-w-0 flex-[999_1_560px]">
        <div class="qs-qclip overflow-hidden rounded-2xl border border-[rgba(224,184,106,0.3)] bg-[var(--bg-1)]">
          <img src={full("qengine-taste-fingerprint")} alt="QEngine taste fingerprint view" width="1440" height="900" loading="lazy" class="h-auto w-full" />
        </div>
      </div>
      <div class="qs-up min-w-0 flex-[1_1_340px]">
        <p class="flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.12em] text-[var(--warm)]">
          03 — QEngine
          <span class="rounded-md border border-[rgba(224,184,106,0.35)] px-2 py-0.5 text-[10px] tracking-[0.1em]">Opt-in</span>
        </p>
        <h2 class="font-display mt-4 text-[clamp(44px,5.6vw,80px)] font-extrabold leading-[0.96] tracking-[-0.045em]">It learns<br />your taste.</h2>
        <p class="mt-6 text-lg leading-relaxed text-[var(--muted)]">
          A Rust engine for recommendations and a taste fingerprint built from what you actually play. Off by default; switch it on with one flag.
        </p>
        <div class="mt-7 inline-flex items-center gap-2.5 rounded-[10px] border border-[var(--line)] bg-[var(--chip)] px-3.5 py-2.5 font-mono text-sm">
          <span class="text-[var(--muted)]">env</span><span>ENTERPRISE=<span class="text-[var(--warm)]">true</span></span>
        </div>
      </div>
    </section>

    <!-- Self-host teaser -->
    <section id="selfhost" class="border-t border-[var(--line)] bg-[var(--panel)]">
      <div class="mx-auto flex max-w-[1240px] flex-wrap items-center gap-[clamp(40px,6vw,80px)] px-4 py-24 sm:px-6 md:py-40 lg:px-10">
        <div class="qs-up min-w-0 flex-[1_1_380px]">
          <p class="qs-eyebrow">04 — Self-host</p>
          <h2 class="font-display mt-4 text-[clamp(44px,5.6vw,80px)] font-extrabold leading-[0.96] tracking-[-0.045em]">Your data.<br />Your box.</h2>
          <p class="mt-6 text-lg leading-relaxed text-[var(--muted)]">
            Start small on SQLite, or scale up with Postgres and Redis through Docker Compose. Same app either way.
          </p>
          <div class="mt-8 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr))]">
            <div class="rounded-xl border border-[var(--line)] bg-[var(--bg-1)] p-4"><p class="text-[13px] text-[var(--muted)]">Database</p><p class="mt-1.5 font-semibold">SQLite or Postgres</p></div>
            <div class="rounded-xl border border-[var(--line)] bg-[var(--bg-1)] p-4"><p class="text-[13px] text-[var(--muted)]">Cache &amp; queues</p><p class="mt-1.5 font-semibold">In-memory or Redis</p></div>
          </div>
          <a href={SELF_HOST_PATH} class="qs-mag qs-btn-ghost mt-8 inline-flex min-h-[50px] items-center gap-2.5 rounded-[10px] border border-[var(--line-strong)] bg-[var(--bg-1)] px-[22px] font-semibold">
            Read the self-host guide
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
        </div>
        <div class="qs-term min-w-0 flex-[999_1_520px]">
          <div class="hatch">
            <div class="overflow-hidden rounded-2xl border border-[var(--line-strong)] bg-[var(--term)] shadow-[0_40px_90px_rgba(0,0,0,0.5)]">
              <div class="flex items-center gap-[7px] border-b border-[var(--line)] bg-[var(--paper)] px-4 py-3">
                <span aria-hidden="true" class="size-2.5 rounded-full bg-[var(--danger)]"></span>
                <span aria-hidden="true" class="size-2.5 rounded-full bg-[var(--warm)]"></span>
                <span aria-hidden="true" class="size-2.5 rounded-full bg-[var(--accent)]"></span>
                <span class="ml-3.5 font-mono text-xs text-[var(--muted)]">~/questory</span>
              </div>
              <div class="qs-code p-[clamp(20px,3vw,32px)] text-[clamp(13px,1.3vw,15px)] leading-[2]">
                <div class="qs-tline"><span class="text-[var(--accent)]">$</span> curl -LO https://raw.githubusercontent.com/Questory-Labs/Questory/main/docker-compose.yml</div>
                <div class="qs-tline"><span class="text-[var(--accent)]">$</span> cp .env.selfhosted.example .env</div>
                <div class="qs-tline"><span class="text-[var(--accent)]">$</span> docker compose --profile selfhosted --env-file .env up -d</div>
                <div class="qs-tline text-[var(--muted)]"># web  → http://localhost:3000</div>
                <div class="qs-tline text-[var(--muted)]"># api  → http://localhost:4000</div>
                <div class="qs-tline"><span class="text-[var(--accent)]">$</span> <span class="qs-caret" aria-hidden="true"></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="qs-final mx-auto max-w-[1240px] px-4 pb-20 pt-32 text-center sm:px-6 md:pb-28 md:pt-52 lg:px-10">
      <h2 class="qs-final-h font-display mx-auto max-w-[1000px] text-[clamp(48px,8vw,120px)] font-extrabold leading-[0.92] tracking-[-0.05em]">
        Your library has stories.<br /><span class="text-[var(--accent)]">Read them.</span>
      </h2>
      <div class="qs-final-cta mt-12 flex flex-wrap justify-center gap-3.5">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="qs-mag qs-btn-primary inline-flex min-h-[58px] items-center gap-2.5 rounded-xl bg-[var(--accent)] px-8 text-[17px] font-semibold text-[var(--bg-0)]">
          Get Questory <Fragment set:html={arrowUpRight} />
        </a>
        <a href={SCREENSHOTS_PATH} class="qs-mag qs-btn-ghost inline-flex min-h-[58px] items-center rounded-xl border border-[var(--line-strong)] bg-[var(--bg-1)] px-8 text-[17px] font-semibold">
          Browse screenshots
        </a>
      </div>
    </section>
  </main>
  <SiteFooter wordmark />
</BaseLayout>

<script>
  import { gsap, ScrollTrigger, MOTION_QUERY, DESKTOP_QUERY, PIN_PRIORITY, charsIn, initChrome, velocityMarquee } from "../scripts/motion";

  initChrome();

  const mm = gsap.matchMedia();
  mm.add({ motion: MOTION_QUERY, desk: DESKTOP_QUERY }, (ctx) => {
    const { motion, desk } = ctx.conditions as { motion: boolean; desk: boolean };
    if (!motion) return;

    gsap
      .timeline({ defaults: { ease: "expo.out" } })
      .from(".qs-pill", { y: 24, opacity: 0, scale: 0.9, duration: 0.9 }, 0.3)
      .add(charsIn(".qs-hero h1"), 0.5)
      .from(".qs-hero-sub, .qs-hero-cta > *", { y: 36, opacity: 0, duration: 1.1, stagger: 0.09 }, 0.9)
      .from(".qs-hero-shot", { y: 220, rotationX: 42, scale: 0.84, opacity: 0, transformPerspective: 1600, transformOrigin: "50% 0%", duration: 2 }, 1)
      .from(".qs-chip", { scale: 0, opacity: 0, duration: 1.1, stagger: 0.14, ease: "back.out(2.2)" }, 1.8);

    gsap.to(".qs-chip-in", { y: -12, duration: 2.6, ease: "sine.inOut", yoyo: true, repeat: -1, stagger: 0.8 });

    gsap
      .timeline({ scrollTrigger: { trigger: ".qs-hero", start: "top top", end: "bottom top", scrub: 0.5 } })
      .to(".qs-hero-copy", { yPercent: -40, opacity: 0, ease: "none" }, 0)
      .to(".qs-hero-scale", { scale: 1.12, ease: "none" }, 0)
      .to(".qs-chip-a", { y: -200, ease: "none" }, 0)
      .to(".qs-chip-b", { y: -300, ease: "none" }, 0)
      .to(".qs-chip-c", { y: -140, ease: "none" }, 0);

    const marquee = document.querySelector(".qs-marquee");
    const marqueeWrap = document.querySelector(".qs-marquee-wrap");
    const stopMarquee = marquee && marqueeWrap ? velocityMarquee([{ el: marquee }], marqueeWrap, 28) : undefined;

    gsap.fromTo(".qs-w", { opacity: 0.12 }, {
      opacity: 1,
      stagger: 0.06,
      ease: "none",
      scrollTrigger: { trigger: ".qs-manifesto", start: "top 70%", end: "bottom 55%", scrub: 0.5 },
    });

    gsap.from(".qs-cardw", {
      y: 160,
      opacity: 0,
      rotation: (i: number) => [-7, 5, -3, 6, -5, 3][i % 6],
      duration: 1.3,
      ease: "expo.out",
      stagger: 0.09,
      scrollTrigger: { trigger: ".qs-shelf-grid", start: "top 85%" },
    });

    if (desk) {
      const wrap = document.querySelector<HTMLElement>(".qs-hwrap")!;
      const track = document.querySelector<HTMLElement>(".qs-htrack")!;
      const distance = () => Math.max(0, track.scrollWidth - wrap.clientWidth);
      const horizontal = gsap.to(track, {
        x: () => -distance(),
        ease: "none",
        scrollTrigger: {
          trigger: wrap,
          start: "top top",
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.5,
          invalidateOnRefresh: true,
          refreshPriority: PIN_PRIORITY + 1,
        },
      });
      gsap.to(".qs-hbar", {
        scaleX: 1,
        ease: "none",
        scrollTrigger: { trigger: wrap, start: "top top", end: () => `+=${distance()}`, scrub: 0.5, invalidateOnRefresh: true, refreshPriority: PIN_PRIORITY + 1 },
      });
      gsap.utils.toArray<HTMLElement>(".qs-hpanel").forEach((panel) => {
        const img = panel.querySelector(".qs-hframe img");
        if (img) {
          // Constant scale + translate only: the layer is rasterised once and just slides.
          gsap.fromTo(img, { scale: 1.06, xPercent: -2.5 }, {
            xPercent: 2.5,
            ease: "none",
            scrollTrigger: { trigger: panel, containerAnimation: horizontal, start: "left right", end: "right left", scrub: true },
          });
        }
        const copy = panel.querySelectorAll(".qs-hcopy > *");
        if (copy.length) {
          gsap.from(copy, {
            y: 50,
            opacity: 0,
            stagger: 0.08,
            duration: 0.9,
            ease: "expo.out",
            scrollTrigger: { trigger: panel, containerAnimation: horizontal, start: "left 70%", toggleActions: "play none none reverse" },
          });
        }
      });

      const panels = gsap.utils.toArray<HTMLElement>(".qs-mpanel");
      const stack = gsap.timeline({
        scrollTrigger: {
          trigger: ".qs-modpin",
          start: "top top",
          end: `+=${(panels.length - 1) * 110}%`,
          pin: true,
          scrub: 0.5,
          refreshPriority: PIN_PRIORITY,
        },
      });
      panels.slice(1).forEach((panel, i) => {
        stack
          .fromTo(panel, { yPercent: 115, rotation: 3 }, { yPercent: 0, rotation: 0, ease: "power2.out" }, i)
          .to(panels[i], { scale: 0.9, yPercent: -6, opacity: 0.3, ease: "none" }, i);
      });
    } else {
      gsap.utils.toArray<HTMLElement>(".qs-hpanel, .qs-mpanel").forEach((panel) => {
        gsap.from(panel, { y: 90, opacity: 0, duration: 1.1, ease: "expo.out", scrollTrigger: { trigger: panel, start: "top 88%" } });
      });
    }

    gsap
      .timeline({ scrollTrigger: { trigger: ".qs-qengine", start: "top 85%", end: "center 50%", scrub: 0.5 } })
      .fromTo(".qs-qclip", { clipPath: "circle(5% at 50% 50%)" }, { clipPath: "circle(80% at 50% 50%)", ease: "none" }, 0)
      .fromTo(".qs-qclip img", { scale: 1.5, rotation: -4 }, { scale: 1, rotation: 0, ease: "none" }, 0);

    gsap.from(".qs-tline", {
      clipPath: "inset(0 100% 0 0)",
      duration: 0.8,
      ease: "steps(26)",
      stagger: 0.5,
      scrollTrigger: { trigger: ".qs-term", start: "top 72%" },
    });

    gsap.from(".qs-final-h", {
      scale: 2.1,
      opacity: 0,
      filter: "blur(12px)",
      ease: "none",
      scrollTrigger: { trigger: ".qs-final", start: "top bottom", end: "center 60%", scrub: 0.5 },
    });
    gsap.from(".qs-final-cta > *", { y: 60, opacity: 0, stagger: 0.1, duration: 1, ease: "expo.out", scrollTrigger: { trigger: ".qs-final-cta", start: "top 92%" } });

    gsap.from(".qs-footer-mark .qs-char", {
      yPercent: 110,
      stagger: 0.06,
      ease: "none",
      scrollTrigger: { trigger: ".qs-footer", start: "top bottom", end: "bottom bottom", scrub: 0.5 },
    });

    ScrollTrigger.refresh();
    return stopMarquee;
  });
</script>
