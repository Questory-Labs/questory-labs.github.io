---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { gameFeatures, mediaGroups, worksWith, GITHUB_URL, RAW_REPO_URL, SELF_HOST_PATH } from "../data/features";
import { SCREENSHOTS_PATH } from "../data/site";

const full = (id: string) => `/screenshots/full/${id}.webp`;
const pad = (n: number) => String(n).padStart(2, "0");
const pick = (titles: string[]) => gameFeatures.filter((f) => titles.includes(f.title));

const mediaMeta: Record<string, { key: string; label: string; tint: string; title: string; tag: string; body: string; sources: string[] }> = {
  music: { key: "listen", label: "Listen", tint: "var(--music)", title: "Music", tag: "Optional · ListenBrainz · multi-scrobbler", body: "Hear your year take shape.", sources: ["ListenBrainz", "Spotify", "Last.fm", "multi-scrobbler"] },
  watch: { key: "watch", label: "Watch", tint: "var(--watch)", title: "Movies & TV", tag: "Optional · Movies · TV · Anime", body: "Every episode, accounted for.", sources: ["Trakt", "Letterboxd", "AniList", "MAL", "Plex / Jellyfin"] },
  read: { key: "read", label: "Read", tint: "var(--read)", title: "Manga & books", tag: "Optional · Manga · Manhwa · Novels", body: "Chapters, logged.", sources: ["AniList", "MAL", "Kitsu", "Bangumi", "Shikimori"] },
};

const modules = [
  {
    key: "play",
    label: "Play",
    tint: "var(--games)",
    title: "Steam library",
    tag: "Core · always on",
    body: "Playtime, backlog, deals and friends — the heart of Questory.",
    sources: ["Steam", "Epic", "GOG"],
    shot: "steam-dashboard",
    items: pick(["Dashboard", "Wishlist", "Collections", "Family insights"]),
  },
  ...mediaGroups.map((group) => ({ ...mediaMeta[group.id], shot: `${group.id}-dashboard`, items: group.features })),
];

const gameShots = [
  { id: "steam-wishlist", title: "Wishlist" },
  { id: "steam-multiplayer", title: "Multiplayer planner" },
  { id: "steam-cost", title: "Cost analytics" },
];

const highlight = new Set(["actually", "read", "play,", "skip,", "next,", "tonight."]);
const manifesto =
  "Questory turns the wall of games you bought on sale into something you can actually read — what you play, what you skip, what's worth buying next, and who's free tonight."
    .split(" ")
    .map((word) => ({ word, hl: highlight.has(word) }));

const startCmd = "docker compose --profile selfhosted --env-file .env up -d";
const steps = [
  { t: "Grab the compose file and env template", lines: [`curl -LO ${RAW_REPO_URL}docker-compose.yml`, `curl -LO ${RAW_REPO_URL}.env.selfhosted.example`] },
  { t: "Set your secrets", lines: ["cp .env.selfhosted.example .env"], note: "# SESSION_SECRET, STEAM_API_KEY" },
  { t: "Start it", lines: [startCmd], note: "# web :3000 · api :4000" },
];
---

<BaseLayout>
  <SiteHeader />
  <main id="top" class="-mt-[72px]">
    <section aria-labelledby="hero" class="relative flex min-h-[min(860px,100vh)] flex-col items-center justify-end overflow-hidden px-4 pb-[72px] pt-40 text-center">
      <canvas data-hero width="1050" height="672" aria-hidden="true" class="absolute left-1/2 top-10 h-auto w-[min(1050px,120vw)] -translate-x-1/2"></canvas>
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[420px] bg-[linear-gradient(0deg,var(--bg-0)_30%,transparent)]"></div>
      <p class="pill q-in relative m-0" style="--i: 1"><span class="dot q-live text-[var(--ok)]" aria-hidden="true"></span>Self-hosted · source-available · Steam-first</p>
      <h1 id="hero" class="q-in relative mb-0 mt-[22px] max-w-[900px] text-[clamp(44px,7vw,96px)] font-normal leading-[0.98] tracking-[-0.05em] [perspective:600px]" style="--i: 2">
        <span class="sr-only">Every hour you played, heard, watched or read — remembered.</span>
        <span aria-hidden="true">Every hour you <em data-word class="font-serif q-word text-[#bfe6dc]">played</em>,<br />remembered.</span>
      </h1>
      <p class="q-in relative mb-0 mt-[22px] max-w-[540px] text-[17px] text-[var(--muted-strong)]" style="--i: 3">
        Weekly insights across your Steam library, music, shows and reading — self-hosted, on your own hardware.
      </p>
      <div class="q-in relative mt-[34px] flex flex-wrap justify-center gap-3" style="--i: 4">
        <a href={SELF_HOST_PATH} class="q-btn q-btn-primary">Get Questory</a>
        <a href={SCREENSHOTS_PATH} class="q-btn q-btn-ghost">See it running</a>
      </div>
      <p class="font-serif q-in relative mb-0 mt-14 text-lg text-[var(--faint)]" style="--i: 5">play. listen. watch. read.</p>
      <span aria-hidden="true" class="q-cue relative mt-3.5 h-7 w-px bg-[linear-gradient(var(--muted-strong),transparent)]"></span>
    </section>

    <section aria-label="Works with" class="overflow-hidden border-y border-[var(--line)] py-[18px] [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]">
      <div class="q-marq flex w-max gap-14 text-lg text-[var(--faint)]">
        {[false, true].map((dup) => worksWith.map((s) => <span class="whitespace-nowrap" aria-hidden={dup ? "true" : undefined}>{s}&nbsp;&nbsp;·</span>))}
      </div>
    </section>

    <section aria-labelledby="why" class="mx-auto max-w-[1180px] px-4 pt-[120px]">
      <p id="why" class="q-eyebrow">Why Questory</p>
      <p class="q-reveal mb-0 mt-5 max-w-[1000px] text-[clamp(28px,3.6vw,48px)] font-light leading-[1.12] tracking-[-0.035em] text-[var(--muted-strong)]">
        {manifesto.map(({ word, hl }) => <>{hl ? <em class="font-serif text-[var(--ink)]">{word}</em> : word}{" "}</>)}
      </p>
    </section>

    <section id="modules" aria-labelledby="mh" class="mx-auto max-w-[1180px] px-4 pb-10 pt-[120px]">
      <p class="q-eyebrow">01 — Modules</p>
      <h2 id="mh" class="q-h2 max-w-[760px]">Play first. <em class="font-serif">Then listen, watch and read.</em></h2>
      <p class="mb-0 mt-4 max-w-[560px] text-[var(--muted-strong)]">Games are always on. Music, Watch and Read are optional modules you switch on when you self-host — same account, same database.</p>
      <div role="tablist" aria-label="Module" class="relative mt-9 inline-grid max-w-full grid-cols-[repeat(4,minmax(0,110px))] rounded-full border border-[var(--line)] bg-[rgba(255,255,255,0.04)] p-1">
        <span data-tab-ind aria-hidden="true" class="q-slide absolute bottom-1 left-1 top-1 w-[calc((100%-8px)/4)] rounded-full bg-[rgba(255,255,255,0.1)] shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]"></span>
        {
          modules.map((mod, i) => (
            <button type="button" role="tab" id={`tab-${mod.key}`} aria-controls={`panel-${mod.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={i} class="relative inline-flex min-h-[42px] cursor-pointer items-center justify-center gap-[7px] border-0 bg-transparent text-sm text-[var(--muted)] transition-colors aria-selected:text-white">
              <span class="dot" style={`color: ${mod.tint}`} aria-hidden="true"></span>
              {mod.label}
            </button>
          ))
        }
      </div>
      {
        modules.map((mod, i) => (
          <div role="tabpanel" id={`panel-${mod.key}`} aria-labelledby={`tab-${mod.key}`} hidden={i !== 0} class="mt-[22px] flex flex-wrap items-stretch gap-[22px]">
            <div class="q-g q-frame min-w-0 flex-[1.7_1_560px] overflow-hidden p-2.5">
              <div class="overflow-hidden rounded-[20px] border border-[rgba(255,255,255,0.06)]">
                <img class="q-shot block h-auto w-full" src={full(mod.shot)} alt={`${mod.title} dashboard`} width="1440" height="900" loading={i === 0 ? "eager" : "lazy"} />
              </div>
            </div>
            <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-2.5">
              <p class="label-mono m-0" style={`color: ${mod.tint}`}>{mod.tag}</p>
              <h3 class="m-0 text-[34px] font-light tracking-[-0.03em]">{mod.title}</h3>
              <p class="m-0 text-[var(--muted-strong)]">{mod.body}</p>
              <div class="mb-2 flex flex-wrap gap-1.5">{mod.sources.map((s) => <span class="chip">{s}</span>)}</div>
              {mod.items.map((it) => (
                <div class="q-feat rounded-[18px] border border-[rgba(255,255,255,0.06)] px-4 py-3.5">
                  <p class="m-0 font-normal">{it.title}</p>
                  <p class="mb-0 mt-0.5 text-sm text-[var(--muted)]">{it.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section id="play" aria-labelledby="gh" class="mx-auto max-w-[1180px] px-4 pb-10 pt-[100px]">
      <p class="q-eyebrow">02 — Games, in depth</p>
      <h2 id="gh" class="q-h2">Every hour, every dollar, <em class="font-serif">every friend.</em></h2>
      <div class="mt-10 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))]">
        {
          gameShots.map((shot, i) => (
            <figure class="q-g q-frame q-reveal m-0 overflow-hidden p-2" style={`--i: ${i}`}>
              <div class="overflow-hidden rounded-[17px] border border-[rgba(255,255,255,0.06)]">
                <img class="q-shot block aspect-[16/10] h-auto w-full object-cover object-left-top" src={full(shot.id)} alt={`${shot.title} view`} width="1440" height="900" loading="lazy" />
              </div>
              <figcaption class="px-2.5 pb-2 pt-3.5">{shot.title}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="mt-3 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr))]">
        {
          gameFeatures.map((g, i) => (
            <div class="q-feat rounded-[24px] border border-[rgba(255,255,255,0.06)] p-[22px]">
              <p class="q-num m-0 text-[40px] font-extralight leading-none tracking-[-0.04em]">{pad(i + 1)}</p>
              <h3 class="mb-0 mt-[18px] text-lg font-normal">{g.title}</h3>
              <p class="mb-0 mt-1 text-sm text-[var(--muted)]">{g.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="qengine" aria-labelledby="qh" class="mx-auto max-w-[1180px] px-4 pb-10 pt-[100px]">
      <div class="q-accent q-reveal flex flex-wrap items-center gap-8 p-[clamp(24px,4vw,48px)] shadow-[var(--glass-edge),0_30px_60px_-30px_rgba(0,0,0,0.9)]">
        <canvas data-fingerprint width="360" height="360" aria-hidden="true" class="h-auto w-[300px] max-w-full flex-none rounded-[24px] bg-[rgba(0,0,0,0.35)]"></canvas>
        <div class="min-w-0 flex-[1_1_360px]">
          <p class="q-eyebrow !text-[var(--warm)]">03 — QEngine · Opt-in</p>
          <h2 id="qh" class="q-h2 !text-[clamp(36px,4.6vw,60px)]">It learns <em class="font-serif !text-[var(--warm-ink)]">your taste.</em></h2>
          <p class="mb-0 mt-[18px] max-w-[520px] text-[var(--muted-strong)]">
            A Rust engine for recommendations and a taste fingerprint built from what you actually play. Off by default — switch it on with one flag.
          </p>
          <p class="mb-0 mt-[22px] inline-flex rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(0,0,0,0.4)] px-4 py-2.5 font-mono text-sm">
            <span class="text-[var(--muted)]">ENTERPRISE=</span><span class="text-[var(--warm-ink)]">true</span>
          </p>
          <p class="mb-0 mt-4 max-w-[520px] text-sm text-[var(--faint)]">QEngine images ship from the private repo only — binary-only, personal / noncommercial license.</p>
          <a href={`${SCREENSHOTS_PATH}#qengine`} class="mt-4 inline-flex items-center gap-2 text-sm text-[var(--warm-ink)] underline-offset-4 hover:underline">See the taste fingerprint →</a>
        </div>
      </div>
    </section>

    <section id="selfhost" aria-labelledby="sh" class="mx-auto max-w-[1180px] px-4 pb-10 pt-[100px]">
      <p class="q-eyebrow">04 — Self-host</p>
      <h2 id="sh" class="q-h2">Your data. <em class="font-serif">Your box.</em></h2>
      <p class="mb-0 mt-4 max-w-[560px] text-[var(--muted-strong)]">Start small on SQLite with in-memory cache, or scale up with Postgres and Redis through Docker Compose. Same app either way.</p>
      <ol class="m-0 mt-9 grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))]">
        {
          steps.map((s, i) => (
            <li class="q-feat q-reveal rounded-[24px] border border-[rgba(255,255,255,0.06)] p-[22px]" style={`--i: ${i}`}>
              <p class="m-0 font-mono text-[11px] text-[var(--faint)]">{pad(i + 1)}</p>
              <h3 class="mb-3 mt-2.5 text-lg font-normal">{s.t}</h3>
              <code class="q-term block px-3.5 py-3 text-xs [overflow-wrap:anywhere]">
                {s.lines.map((l) => <span class="block">{l}</span>)}
                {s.note && <span class="block text-[var(--faint)]">{s.note}</span>}
              </code>
            </li>
          ))
        }
      </ol>
      <div data-copy-scope class="mt-3.5 flex flex-wrap items-center gap-2.5 rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[var(--term)] py-2 pl-[18px] pr-2">
        <code class="min-w-0 flex-1 font-mono text-[13px] [overflow-wrap:anywhere]"><span class="text-[var(--faint)]">$ </span><span class="q-copy-text">{startCmd}</span></code>
        <button type="button" data-copy class="q-btn q-btn-ghost q-btn-sm !rounded-[10px] bg-[rgba(255,255,255,0.06)]" aria-label="Copy start command"><span class="q-copy-label" aria-live="polite">Copy</span></button>
      </div>
      <p class="mb-0 mt-5 text-sm text-[var(--muted)]">
        Building from source instead? Clone the repo, copy the same template, and start with <code class="code-inline">--build</code>.
        <a href={SELF_HOST_PATH} class="text-[var(--ink)] underline underline-offset-4">Read the self-host guide</a>
      </p>
    </section>

    <section aria-labelledby="end" class="px-4 pb-20 pt-[140px] text-center">
      <h2 id="end" class="q-reveal m-0 text-[clamp(40px,6vw,88px)] font-light leading-none tracking-[-0.05em]">Your library has stories.<br /><em class="font-serif text-[var(--muted-strong)]">Read them.</em></h2>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={SELF_HOST_PATH} class="q-btn q-btn-primary">Get Questory</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="q-btn q-btn-ghost">View on GitHub</a>
        <a href={SCREENSHOTS_PATH} class="q-btn q-btn-ghost">Browse screenshots</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { initCopy, initReveal, paintFingerprint, animateWhileVisible, reducedMotion, MODULE_TINTS, paintPlus } from "../scripts/motion";

  initReveal();
  initCopy();

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
  const ind = document.querySelector<HTMLElement>("[data-tab-ind]");
  const select = (i: number, focus = false) => {
    tabs.forEach((tab, k) => {
      const on = k === i;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !on;
    });
    if (ind) ind.style.transform = `translateX(${i * 100}%)`;
    if (focus) tabs[i].focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(i));
    tab.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") select((i + 1) % tabs.length, true);
      else if (e.key === "ArrowLeft") select((i - 1 + tabs.length) % tabs.length, true);
      else if (e.key === "Home") select(0, true);
      else if (e.key === "End") select(tabs.length - 1, true);
      else return;
      e.preventDefault();
    });
  });

  const fp = document.querySelector<HTMLCanvasElement>("canvas[data-fingerprint]");
  if (fp) animateWhileVisible(fp, (t) => paintFingerprint(fp, t));

  const hero = document.querySelector<HTMLCanvasElement>("canvas[data-hero]");
  const word = document.querySelector<HTMLElement>("[data-word]");
  const ctx = hero?.getContext("2d");
  if (hero && ctx) {
    const GW = 150;
    const GH = 96;
    const STEP = 7;
    const words = ["played", "heard", "watched", "read"];
    const wordColors = ["#bfe6dc", "#f5c6d1", "#efd9a8", "#c9d1f6"];

    const shape = (kind: string) => {
      const c = document.createElement("canvas");
      c.width = GW;
      c.height = GH;
      const x = c.getContext("2d")!;
      const g = x.createRadialGradient(GW * 0.5, GH * 0.42, 4, GW * 0.5, GH * 0.5, GW * 0.42);
      g.addColorStop(0, "rgba(255,255,255,1)");
      g.addColorStop(1, "rgba(255,255,255,0.45)");
      x.fillStyle = g;
      const rr = (a: number, b: number, w: number, h: number, r: number) => {
        x.beginPath();
        x.moveTo(a + r, b);
        x.arcTo(a + w, b, a + w, b + h, r);
        x.arcTo(a + w, b + h, a, b + h, r);
        x.arcTo(a, b + h, a, b, r);
        x.arcTo(a, b, a + w, b, r);
        x.closePath();
      };
      if (kind === "pad") {
        x.beginPath(); x.moveTo(48, 22); x.lineTo(102, 22); x.bezierCurveTo(118, 22, 126, 30, 130, 46); x.lineTo(138, 74); x.bezierCurveTo(141, 86, 133, 92, 125, 92); x.bezierCurveTo(118, 92, 114, 87, 110, 81); x.lineTo(102, 70); x.lineTo(48, 70); x.lineTo(40, 81); x.bezierCurveTo(36, 87, 32, 92, 25, 92); x.bezierCurveTo(17, 92, 9, 86, 12, 74); x.lineTo(20, 46); x.bezierCurveTo(24, 30, 32, 22, 48, 22); x.fill();
        x.globalCompositeOperation = "destination-out";
        x.fillRect(38, 42, 16, 5); x.fillRect(43.5, 36.5, 5, 16);
        [[104, 37], [113, 45], [95, 45], [104, 53]].forEach(([px, py]) => { x.beginPath(); x.arc(px, py, 3.2, 0, 7); x.fill(); });
        x.beginPath(); x.arc(62, 60, 6, 0, 7); x.fill(); x.beginPath(); x.arc(88, 60, 6, 0, 7); x.fill();
      } else if (kind === "vinyl") {
        x.beginPath(); x.arc(75, 48, 44, 0, 7); x.fill();
        x.globalCompositeOperation = "destination-out";
        [38, 31, 24].forEach((r) => { x.lineWidth = 1.2; x.strokeStyle = "rgba(0,0,0,0.6)"; x.beginPath(); x.arc(75, 48, r, 0, 7); x.stroke(); });
        x.beginPath(); x.arc(75, 48, 3, 0, 7); x.fill();
        x.globalCompositeOperation = "source-over"; x.fillStyle = "rgba(255,255,255,0.35)"; x.beginPath(); x.arc(75, 48, 12, 0, 7); x.fill();
      } else if (kind === "play") {
        rr(22, 14, 106, 66, 8); x.fill();
        x.fillRect(66, 80, 18, 6); rr(52, 86, 46, 4, 2); x.fill();
        x.globalCompositeOperation = "destination-out";
        x.beginPath(); x.moveTo(66, 32); x.lineTo(66, 62); x.lineTo(90, 47); x.closePath(); x.fill();
      } else {
        x.beginPath(); x.moveTo(75, 24); x.bezierCurveTo(60, 14, 36, 12, 14, 18); x.lineTo(14, 82); x.bezierCurveTo(36, 76, 60, 78, 75, 88); x.bezierCurveTo(90, 78, 114, 76, 136, 82); x.lineTo(136, 18); x.bezierCurveTo(114, 12, 90, 14, 75, 24); x.closePath(); x.fill();
        x.globalCompositeOperation = "destination-out"; x.fillRect(74.2, 22, 1.6, 66);
        x.fillStyle = "rgba(0,0,0,0.5)"; [34, 44, 54, 64].forEach((y) => { x.fillRect(24, y, 40, 1); x.fillRect(86, y, 40, 1); });
      }
      const d = x.getImageData(0, 0, GW, GH).data;
      const out = new Float32Array(GW * GH);
      for (let i = 0; i < GW * GH; i++) out[i] = d[i * 4 + 3] / 255;
      return out;
    };

    const shapes = ["pad", "vinyl", "play", "book"].map(shape);
    let seed = 9;
    const rnd = new Float32Array(GW * GH).map(() => {
      seed = (seed * 16807) % 2147483647;
      return seed / 2147483647;
    });
    let mouse = { x: -999, y: -999 };
    let shown = 0;
    const still = reducedMotion();

    if (!still) {
      hero.style.pointerEvents = "auto";
      hero.addEventListener("pointermove", (ev) => {
        const r = hero.getBoundingClientRect();
        mouse = { x: ((ev.clientX - r.left) * hero.width) / r.width, y: ((ev.clientY - r.top) * hero.height) / r.height };
      });
      hero.addEventListener("pointerleave", () => {
        mouse = { x: -999, y: -999 };
      });
    }

    const paint = (time: number) => {
      ctx.clearRect(0, 0, hero.width, hero.height);
      const phase = time / 3.6;
      const idx = Math.floor(phase) % 4;
      const nxt = (idx + 1) % 4;
      const frac = phase - Math.floor(phase);
      if (word && idx !== shown && !still) {
        shown = idx;
        word.textContent = words[idx];
        word.style.color = wordColors[idx];
        word.classList.remove("q-word");
        void word.offsetWidth;
        word.classList.add("q-word");
      }
      const A = shapes[idx];
      const B = shapes[nxt];
      for (let gy = 0; gy < GH; gy++) {
        for (let gx = 0; gx < GW; gx++) {
          const i = gy * GW + gx;
          const r = rnd[i];
          const k = Math.max(0, Math.min(1, (frac - 0.62 - r * 0.26) / 0.12));
          let v = A[i] * (1 - k) + B[i] * k;
          const tint = k < 0.5 ? MODULE_TINTS[idx] : MODULE_TINTS[nxt];
          if (v < 0.04) {
            if (r > 0.993) v = 0.25 + 0.6 * Math.max(0, Math.sin(time * 1.3 + r * 900));
            else continue;
          }
          let px = gx * STEP + STEP / 2;
          let py = gy * STEP + STEP / 2;
          const dx = px - mouse.x;
          const dy = py - mouse.y;
          const dd = dx * dx + dy * dy;
          if (dd < 9000) {
            const f = 1 - dd / 9000;
            px += dx * f * 0.35;
            py += dy * f * 0.35;
            v = Math.min(1, v + f * 0.6);
          }
          const a = v * (0.72 + 0.28 * Math.sin(time * 2.6 + r * 40));
          const warm = gy > GH * 0.35 && gy < GH * 0.75 && gx > GW * 0.3 && gx < GW * 0.7 && v > 0.8 && r < 0.35;
          ctx.fillStyle = `rgba(${warm ? tint : "236,236,238"},${a.toFixed(2)})`;
          paintPlus(ctx, px, py, 0.8 + v * 2.2);
        }
      }
    };

    animateWhileVisible(hero, paint, 0.5);
  }
</script>
