---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
import LandingBackground from "../components/LandingBackground.astro";
import HatchShadow from "../components/HatchShadow.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ScreenshotFrame from "../components/ScreenshotFrame.astro";
import ScreenshotLightbox from "../components/ScreenshotLightbox.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  gameFeatures,
  mediaGroups,
  getFeaturedScreenshots,
  GITHUB_URL,
  SELF_HOST_PATH,
} from "../data/features";
---

<BaseLayout>
  <SiteHeader />

  <section class="relative min-h-[85vh] overflow-hidden">
    <LandingBackground />
    <div
      class="relative z-10 mx-auto flex min-h-[85vh] max-w-5xl flex-col justify-center px-6 py-20"
    >
      <BrandMark
        href={null}
        size="lg"
        wordmarkClass="text-5xl sm:text-7xl md:text-8xl"
        class="gap-4 md:gap-5"
      />
      <p class="section-eyebrow mt-8">Steam-first library and media intelligence</p>
      <p class="mt-4 max-w-xl text-lg text-[var(--muted)] md:text-xl">
        Play, listen, and watch — weekly insights across your Steam library,
        music, and media.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <HatchShadow
            size="sm"
            faceClass="bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-[var(--bg-0)] transition hover:brightness-110"
          >
            View on GitHub
          </HatchShadow>
        </a>
        <a href={SELF_HOST_PATH}>
          <HatchShadow
            size="sm"
            faceClass="border border-[var(--line)] bg-[var(--bg-1)] px-5 py-3 text-sm font-semibold text-[var(--ink)] transition hover:border-[var(--line-strong)]"
          >
            Self-host guide
          </HatchShadow>
        </a>
      </div>
    </div>
  </section>

  <main>
    <section id="features" class="mx-auto max-w-6xl px-6 py-20">
      <p class="section-eyebrow">Games</p>
      <h2
        class="font-display mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
      >
        Your library, decoded
      </h2>
      <p class="mt-3 max-w-2xl text-[var(--muted)]">
        Core Steam features — dashboard, wishlist, collections, cost analytics,
        friends, and more — in one self-hosted app.
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          gameFeatures.map((feature) => (
            <FeatureCard
              title={feature.title}
              description={feature.description}
            />
          ))
        }
      </div>
    </section>

    <section class="border-t border-[var(--line)] bg-[var(--bg-1)]/40">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <p class="section-eyebrow">Optional modules</p>
        <h2
          class="font-display mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Music, watch, and read
        </h2>
        <p class="mt-3 max-w-2xl text-[var(--muted)]">
          Enable music, movie/TV, and manga analytics when you self-host — same
          account, same database, feature-flagged in the UI.
        </p>

        <div class="mt-12 space-y-16">
          {
            mediaGroups.map((group) => (
              <div>
                <div class="mb-6 flex flex-wrap items-baseline gap-3">
                  <h3 class="font-display text-2xl font-semibold tracking-tight">
                    {group.eyebrow}
                  </h3>
                  {group.optional ? (
                    <span class="rounded-[var(--radius)] border border-[var(--line)] bg-[var(--accent-dim)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">
                      Optional
                    </span>
                  ) : null}
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  {group.features.map((feature) => (
                    <FeatureCard
                      title={feature.title}
                      description={feature.description}
                    />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="screenshots" class="mx-auto max-w-6xl px-6 py-20">
      <p class="section-eyebrow">Product</p>
      <h2
        class="font-display mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
      >
        See it in action
      </h2>
      <p class="mt-3 max-w-2xl text-[var(--muted)]">
        A quick look at Questory across games, music, watch, read, and QEngine.
        Browse the full gallery for admin tooling and every module view.
      </p>
      <div class="mt-6">
        <a href="/screenshots/">
          <HatchShadow
            size="sm"
            faceClass="border border-[var(--line)] bg-[var(--bg-1)] px-5 py-3 text-sm font-semibold text-[var(--ink)] transition hover:border-[var(--line-strong)]"
          >
            View all screenshots
          </HatchShadow>
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          getFeaturedScreenshots().map((shot) => (
            <ScreenshotFrame
              id={shot.id}
              title={shot.title}
              group={shot.group}
            />
          ))
        }
      </div>
    </section>

    <section class="border-t border-[var(--line)]">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <HatchShadow size="md">
          <div class="panel-accent p-8 sm:p-10">
            <p class="section-eyebrow">Self-host</p>
            <h2
              class="font-display mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
            >
              Run Questory at home
            </h2>
            <p class="mt-4 max-w-2xl text-[var(--muted)]">
              Docker Compose profiles from a lite SQLite stack to full Postgres
              + Redis and production HTTPS. Personal and noncommercial use under
              the PolyForm Noncommercial license.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={SELF_HOST_PATH}>
                <HatchShadow
                  size="sm"
                  faceClass="bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-[var(--bg-0)] transition hover:brightness-110"
                >
                  Read the self-hosting guide
                </HatchShadow>
              </a>
              <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
                <HatchShadow
                  size="sm"
                  faceClass="border border-[var(--line)] bg-[var(--bg-1)] px-5 py-3 text-sm font-semibold text-[var(--ink)] transition hover:border-[var(--line-strong)]"
                >
                  View source on GitHub
                </HatchShadow>
              </a>
            </div>
          </div>
        </HatchShadow>
      </div>
    </section>
  </main>

  <SiteFooter />
  <ScreenshotLightbox />
</BaseLayout>
