---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { screenshotGroups, GITHUB_URL, SELF_HOST_PATH } from "../../data/features";

const card = (id: string) => `/screenshots/card/${id}.webp`;
const full = (id: string) => `/screenshots/full/${id}.webp`;
const pad = (n: number) => String(n).padStart(2, "0");

const tints: Record<string, string> = {
  games: "var(--games)",
  music: "var(--music)",
  watch: "var(--watch)",
  read: "var(--read)",
  qengine: "var(--warm)",
  rewind: "var(--ink)",
};

const total = screenshotGroups.reduce((n, g) => n + g.shots.length, 0);
---

<BaseLayout
  title="Screenshots — Questory"
  description="Browse Questory screenshots across games, music, watch, read, QEngine, and Rewind."
>
  <SiteHeader />
  <main class="mx-auto max-w-[1240px] px-4 pb-10">
    <section aria-labelledby="sh" class="pb-10 pt-[clamp(56px,9vw,110px)]">
      <p class="q-eyebrow q-in" style="--i: 1">Screenshots — {total} captures</p>
      <h1 id="sh" class="q-h1 q-in" style="--i: 2">See it before <em class="font-serif text-[var(--muted-strong)]">you host it.</em></h1>
      <p class="q-lede q-in max-w-[560px]" style="--i: 3">
        The Questory UI across core Steam features and the optional music, watch, read and QEngine modules, captured from the built-in demo account with sample data. Open any shot full size.
      </p>
    </section>

    <div class="sticky top-[84px] z-30 -mx-4 px-4 pb-4 pt-2 before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-[rgba(12,12,14,0.85)] before:backdrop-blur-md before:content-[''] before:[mask-image:linear-gradient(transparent,#000_16px,#000_70%,transparent)]">
      <div role="group" aria-label="Filter screenshots" class="flex gap-2 overflow-x-auto [scrollbar-width:none]">
        <button type="button" class="q-pill-btn" data-filter="all" aria-pressed="true">All <span class="q-count">{total}</span></button>
        {
          screenshotGroups.map((g) => (
            <button type="button" class="q-pill-btn" data-filter={g.id} aria-pressed="false">
              <span class="dot" style={`color: ${tints[g.id]}`} aria-hidden="true"></span>
              {g.eyebrow}
              <span class="q-count">{g.shots.length}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-[clamp(56px,7vw,96px)] pb-[100px] pt-8">
      {
        screenshotGroups.map((group, gi) => (
          <section id={group.id} data-group={group.id} aria-labelledby={`g-${group.id}`} class="scroll-mt-[150px]">
            <div class="mb-6 flex flex-wrap items-baseline gap-x-4 gap-y-2 border-b border-[var(--line)] pb-4">
              <span class="font-mono text-xs text-[var(--faint)]">{pad(gi + 1)}</span>
              <h2 id={`g-${group.id}`} class="m-0 flex items-center gap-2.5 text-[clamp(28px,3.4vw,40px)] font-light tracking-[-0.03em]">
                <span class="dot" style={`color: ${tints[group.id]}`} aria-hidden="true"></span>
                {group.eyebrow}
              </h2>
              {group.optional && <span class="chip">Optional</span>}
              <span class="label-mono ml-auto">{group.shots.length} {group.shots.length === 1 ? "view" : "views"}</span>
            </div>
            <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr))]">
              {group.shots.map((shot, si) => (
                <button
                  type="button"
                  class="q-shotcard q-reveal"
                  style={`--i: ${si % 3}`}
                  data-shot
                  data-shot-src={full(shot.id)}
                  data-shot-title={shot.title}
                  data-shot-group={group.eyebrow}
                  aria-label={`Open ${group.eyebrow} ${shot.title} screenshot full size`}
                >
                  <span class="block overflow-hidden rounded-[17px] border border-[rgba(255,255,255,0.06)]">
                    <img
                      class="q-shot block aspect-[16/10] h-auto w-full object-cover object-left-top"
                      src={card(shot.id)}
                      srcset={`${card(shot.id)} 800w, ${full(shot.id)} 1440w`}
                      sizes="(min-width: 900px) 33vw, 100vw"
                      alt=""
                      width="800"
                      height="500"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="flex items-center gap-3 px-2.5 pb-1.5 pt-3.5">
                    <span class="font-mono text-[11px] text-[var(--faint)]">{pad(si + 1)}</span>
                    <span class="min-w-0 flex-1 truncate">{shot.title}</span>
                    <span class="q-arrow text-[var(--muted-strong)]" aria-hidden="true">↗</span>
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section aria-labelledby="cta" class="q-g q-reveal mb-10 px-6 py-[clamp(56px,8vw,96px)] text-center">
      <h2 id="cta" class="m-0 text-[clamp(36px,5.4vw,72px)] font-light leading-none tracking-[-0.05em]">Like what you see?<br /><em class="font-serif text-[var(--muted-strong)]">Run it tonight.</em></h2>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={SELF_HOST_PATH} class="q-btn q-btn-primary">Self-host guide</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="q-btn q-btn-ghost">View on GitHub</a>
      </div>
    </section>
  </main>
  <SiteFooter />

  <dialog class="q-lightbox" aria-label="Screenshot viewer">
    <div class="flex w-full max-w-[1200px] items-center justify-between gap-4">
      <p class="m-0 flex min-w-0 items-baseline gap-3.5">
        <span data-lb-pos class="font-mono text-xs text-[var(--muted)]"></span>
        <span data-lb-title class="truncate text-lg"></span>
        <span data-lb-group class="label-mono hidden sm:inline"></span>
      </p>
      <button type="button" data-lb-close class="q-iconbtn" aria-label="Close">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="flex w-full items-center justify-center gap-3 sm:gap-5">
      <button type="button" data-lb-prev class="q-iconbtn" aria-label="Previous screenshot">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <div class="q-lb-frame q-zoom min-w-0">
        <img data-lb-img class="q-lb-img" alt="" decoding="async" />
      </div>
      <button type="button" data-lb-next class="q-iconbtn" aria-label="Next screenshot">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>
    <p class="label-mono m-0">← → to browse · Esc to close</p>
  </dialog>
</BaseLayout>

<script>
  import { initReveal } from "../../scripts/motion";

  initReveal();

  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const applyFilter = (id: string) => {
    filters.forEach((f) => f.setAttribute("aria-pressed", String(f.dataset.filter === id)));
    groups.forEach((g) => {
      g.hidden = id !== "all" && g.dataset.group !== id;
      if (!g.hidden) g.querySelectorAll(".q-reveal").forEach((el) => el.classList.add("is-in"));
    });
  };
  filters.forEach((f) => f.addEventListener("click", () => applyFilter(f.dataset.filter ?? "all")));
  const initial = location.hash.slice(1);
  if (initial && groups.some((g) => g.dataset.group === initial)) applyFilter(initial);

  const dialog = document.querySelector<HTMLDialogElement>(".q-lightbox")!;
  const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!;
  const title = dialog.querySelector<HTMLElement>("[data-lb-title]")!;
  const group = dialog.querySelector<HTMLElement>("[data-lb-group]")!;
  const pos = dialog.querySelector<HTMLElement>("[data-lb-pos]")!;
  const all = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-shot]"));
  let visible: HTMLButtonElement[] = [];
  let index = 0;
  let opener: HTMLButtonElement | null = null;
  const pad = (n: number) => String(n).padStart(2, "0");

  const show = (i: number) => {
    index = (i + visible.length) % visible.length;
    const shot = visible[index];
    img.src = shot.dataset.shotSrc ?? "";
    img.alt = `${shot.dataset.shotGroup} ${shot.dataset.shotTitle} screenshot`;
    title.textContent = shot.dataset.shotTitle ?? "";
    group.textContent = shot.dataset.shotGroup ?? "";
    pos.textContent = `${pad(index + 1)} / ${pad(visible.length)}`;
  };

  const close = () => {
    dialog.close();
  };

  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    opener?.focus();
  });

  all.forEach((shot) => {
    shot.addEventListener("click", () => {
      visible = all.filter((s) => !s.closest<HTMLElement>("[data-group]")?.hidden);
      opener = shot;
      show(visible.indexOf(shot));
      document.documentElement.style.overflow = "hidden";
      dialog.showModal();
    });
  });

  dialog.querySelector("[data-lb-close]")!.addEventListener("click", close);
  dialog.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(index - 1));
  dialog.querySelector("[data-lb-next]")!.addEventListener("click", () => show(index + 1));
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(index - 1);
    else if (e.key === "ArrowRight") show(index + 1);
    else return;
    e.preventDefault();
  });
</script>
