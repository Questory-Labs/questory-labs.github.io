---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SplitText from "../../components/SplitText.astro";
import { screenshotGroups, GITHUB_URL, SELF_HOST_PATH } from "../../data/features";

const card = (id: string) => `/screenshots/card/${id}.webp`;
const full = (id: string) => `/screenshots/full/${id}.webp`;

const allShots = screenshotGroups.flatMap((group) => group.shots);
const stripA = allShots.slice(0, Math.ceil(allShots.length / 2));
const stripB = allShots.slice(Math.ceil(allShots.length / 2));
const sections = screenshotGroups.map((group) => ({ id: group.id, label: group.eyebrow, count: group.shots.length }));
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="Screenshots — Questory"
  description="Browse Questory screenshots across games, music, watch, read, QEngine, and admin."
>
  <SiteHeader />
  <main>
    <section class="qs-hero mx-auto max-w-[1320px] px-4 pt-14 sm:px-6 md:pt-24 lg:px-10">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
        <div class="min-w-0 flex-[1_1_560px]">
          <p class="qs-pill qs-eyebrow">The gallery · {allShots.length} views</p>
          <h1 class="font-display mt-4 text-[clamp(56px,10vw,150px)] font-extrabold leading-[0.9] tracking-[-0.05em]">
            <SplitText lines={[{ text: "See it" }, { text: "in action.", class: "text-[var(--accent)]" }]} />
          </h1>
        </div>
        <p class="qs-hero-sub max-w-[400px] flex-[1_1_300px] text-lg leading-relaxed text-[var(--muted)]">
          The Questory UI across core Steam features and the optional music, watch, read, QEngine, and admin modules. Tap any shot to open it full size.
        </p>
      </div>
    </section>

    <section class="qs-stripwrap mt-14 overflow-hidden py-10 md:mt-20" aria-hidden="true">
      <div class="qs-strip flex flex-col gap-[18px] [transform:rotate(-4deg)_scale(1.08)]">
        {
          [stripA, stripB].map((row, r) => (
            <div class:list={["qs-marquee gap-[18px]", r === 0 ? "qs-row-a" : "qs-row-b"]}>
              {[...row, ...row].map((shot) => (
                <div class="qs-thumb">
                  <img src={card(shot.id)} alt="" width="800" height="500" loading="lazy" />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <div class="qs-filters sticky top-[72px] z-40 mt-10 border-y border-[var(--line)] bg-[rgba(16,16,18,0.94)] md:mt-16">
      <nav aria-label="Jump to module" class="qs-spybar mx-auto flex max-w-[1320px] items-center gap-2 overflow-x-auto px-4 py-3.5 [scrollbar-width:none] sm:px-6 lg:px-10">
        {
          sections.map((section, i) => (
            <a
              href={`#${section.id}`}
              class="qs-pillbtn inline-flex min-h-11 flex-none items-center gap-2 rounded-full border border-[var(--line-strong)] px-4 text-[15px] font-semibold"
              data-spy={section.id}
              aria-current={i === 0 ? "true" : undefined}
            >
              {section.label}
              <span class="font-mono text-xs font-medium opacity-60">{section.count}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <section class="mx-auto flex max-w-[1320px] flex-col gap-[clamp(72px,9vw,120px)] px-4 pb-28 pt-12 sm:px-6 md:pb-40 md:pt-20 lg:px-10">
      {
        screenshotGroups.map((group, gi) => (
          <div id={group.id} data-group={group.id}>
            <div class="qs-gh mb-8 flex flex-wrap items-baseline gap-x-6 gap-y-4 border-b border-[var(--line)] pb-5">
              <span class="qs-ghost font-display text-[clamp(56px,7vw,96px)] font-extrabold leading-[0.8] tracking-[-0.04em]">{pad(gi + 1)}</span>
              <h2 class="font-display text-[clamp(36px,4.4vw,60px)] font-extrabold leading-none tracking-[-0.04em]">{group.eyebrow}</h2>
              {group.optional && (
                <span class="rounded-md border border-[rgba(125,211,192,0.3)] bg-[var(--accent-dim)] px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--accent)]">Optional</span>
              )}
              <span class="ml-auto font-mono text-[13px] text-[var(--muted)]">
                {group.shots.length} {group.shots.length === 1 ? "view" : "views"}
              </span>
            </div>
            <div class="grid gap-[22px] [grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr))]">
              {group.shots.map((shot, si) => (
                <div class:list={[si === 0 && group.shots.length > 2 && "qs-feat"]}>
                  <button
                    type="button"
                    class="qs-card"
                    data-cursor-view
                    data-shot-src={full(shot.id)}
                    data-shot-title={shot.title}
                    data-shot-group={group.eyebrow}
                    aria-label={`Open ${group.eyebrow} ${shot.title} screenshot full size`}
                  >
                    <div class="qs-card-media">
                      <img
                        src={card(shot.id)}
                        srcset={`${card(shot.id)} 800w, ${full(shot.id)} 1440w`}
                        sizes="(min-width: 900px) 33vw, 100vw"
                        alt=""
                        width="800"
                        height="500"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="qs-card-tag">Open ↗</span>
                    </div>
                    <div class="flex items-baseline gap-3 px-1 pt-3.5">
                      <span class="font-mono text-xs text-[var(--muted)]">{pad(si + 1)}</span>
                      <span class="font-display text-xl font-bold tracking-[-0.01em]">{shot.title}</span>
                    </div>
                  </button>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="border-t border-[var(--line)] bg-[var(--panel)]">
      <div class="qs-cta mx-auto max-w-[1320px] px-4 py-24 text-center sm:px-6 md:py-40 lg:px-10">
        <h2 class="font-display mx-auto max-w-[900px] text-[clamp(44px,7vw,100px)] font-extrabold leading-[0.94] tracking-[-0.05em]">
          Like what you see?<br /><span class="text-[var(--accent)]">Run it tonight.</span>
        </h2>
        <div class="mt-11 flex flex-wrap justify-center gap-3.5">
          <a href={SELF_HOST_PATH} class="qs-mag qs-btn-primary inline-flex min-h-14 items-center gap-2.5 rounded-xl bg-[var(--accent)] px-[30px] text-[17px] font-semibold text-[var(--bg-0)]">
            Self-host guide
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="qs-mag qs-btn-ghost inline-flex min-h-14 items-center rounded-xl border border-[var(--line-strong)] bg-[var(--bg-1)] px-[30px] text-[17px] font-semibold">
            View on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <dialog class="qs-lightbox" aria-label="Screenshot viewer">
    <div class="flex items-center justify-between gap-4 border-b border-[var(--line)] px-4 py-4 sm:px-8">
      <div class="flex min-w-0 items-baseline gap-3.5">
        <span class="qs-lb-pos font-mono text-[13px] text-[var(--accent)]"></span>
        <span class="qs-lb-title font-display truncate text-[22px] font-bold"></span>
        <span class="qs-lb-group hidden font-mono text-xs uppercase tracking-[0.1em] text-[var(--muted)] sm:inline"></span>
      </div>
      <button type="button" class="qs-lbbtn qs-lb-close grid size-[46px] place-items-center rounded-xl border border-[var(--line-strong)] bg-[var(--surface)]" aria-label="Close">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="flex min-h-0 flex-1 items-center justify-center gap-2 p-3 sm:gap-6 sm:p-8">
      <button type="button" class="qs-lbbtn qs-lb-prev grid size-[52px] flex-none place-items-center rounded-full border border-[var(--line-strong)] bg-[var(--surface)]" aria-label="Previous screenshot">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <div class="flex h-full min-w-0 flex-1 items-center justify-center">
        <img class="qs-lb-img max-h-full max-w-full rounded-[14px] border border-[var(--line-strong)] object-contain shadow-[0_60px_140px_rgba(0,0,0,0.7)]" alt="" decoding="async" />
      </div>
      <button type="button" class="qs-lbbtn qs-lb-next grid size-[52px] flex-none place-items-center rounded-full border border-[var(--line-strong)] bg-[var(--surface)]" aria-label="Next screenshot">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { gsap, ScrollTrigger, MOTION_QUERY, charsIn, cursorInto, initChrome, setScrollLocked, velocityMarquee } from "../../scripts/motion";

  initChrome();
  const motionOk = () => window.matchMedia(MOTION_QUERY).matches;

  const mm = gsap.matchMedia();
  mm.add(MOTION_QUERY, () => {
    gsap
      .timeline({ defaults: { ease: "expo.out" } })
      .from(".qs-pill", { y: 20, opacity: 0, duration: 0.8 }, 0.3)
      .add(charsIn(".qs-hero h1"), 0.5)
      .from(".qs-hero-sub", { y: 30, opacity: 0, duration: 1 }, 0.9)
      .from(".qs-row-a", { xPercent: 20, opacity: 0, duration: 1.8 }, 0.9)
      .from(".qs-row-b", { xPercent: -20, opacity: 0, duration: 1.8 }, 0.9)
      .from(".qs-filters", { y: 30, opacity: 0, duration: 1, clearProps: "transform" }, 1.2);

    const rowA = document.querySelector(".qs-row-a");
    const rowB = document.querySelector(".qs-row-b");
    const wrap = document.querySelector(".qs-stripwrap");
    const stopMarquee = rowA && rowB && wrap ? velocityMarquee([{ el: rowA }, { el: rowB, reverse: true }], wrap, 50) : undefined;

    gsap.to(".qs-strip", { rotate: 0, scale: 1, ease: "none", scrollTrigger: { trigger: ".qs-stripwrap", start: "top 80%", end: "bottom top", scrub: 0.5 } });
    gsap.to(".qs-hero", { yPercent: -18, opacity: 0.2, ease: "none", scrollTrigger: { trigger: ".qs-hero", start: "top top", end: "bottom top", scrub: 0.5 } });

    document.querySelectorAll<HTMLElement>(".qs-gh").forEach((el) => {
      gsap.from(el.children, { y: 60, opacity: 0, stagger: 0.07, duration: 1.1, ease: "expo.out", scrollTrigger: { trigger: el, start: "top 88%" } });
    });
    const cards = gsap.utils.toArray<HTMLElement>(".qs-card");
    gsap.set(cards, { opacity: 0, y: 90, scale: 0.94 });
    ScrollTrigger.batch(cards, {
      start: "top 94%",
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, { opacity: 1, y: 0, scale: 1, stagger: 0.08, duration: 1.1, ease: "expo.out", overwrite: true, clearProps: "transform" }),
    });

    gsap.from(".qs-cta h2, .qs-cta a", { y: 80, opacity: 0, stagger: 0.1, duration: 1.2, ease: "expo.out", scrollTrigger: { trigger: ".qs-cta", start: "top 80%" } });

    return () => stopMarquee?.();
  });

  // Scrollspy: highlight the pill for the section under the sticky bars.
  const pills = document.querySelectorAll<HTMLAnchorElement>("[data-spy]");
  const spyBar = document.querySelector<HTMLElement>(".qs-spybar");
  const setActive = (id: string) => {
    pills.forEach((pill) => {
      const on = pill.dataset.spy === id;
      if (on) {
        pill.setAttribute("aria-current", "true");
        if (spyBar) spyBar.scrollTo({ left: pill.offsetLeft - spyBar.clientWidth / 2 + pill.offsetWidth / 2, behavior: "smooth" });
      } else {
        pill.removeAttribute("aria-current");
      }
    });
  };
  document.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
    ScrollTrigger.create({
      trigger: group,
      start: "top 45%",
      end: "bottom 45%",
      onToggle: (self) => self.isActive && setActive(group.dataset.group ?? ""),
    });
  });

  // Lightbox
  const dialog = document.querySelector<HTMLDialogElement>(".qs-lightbox")!;
  const lbImg = dialog.querySelector<HTMLImageElement>(".qs-lb-img")!;
  const lbTitle = dialog.querySelector<HTMLElement>(".qs-lb-title")!;
  const lbGroup = dialog.querySelector<HTMLElement>(".qs-lb-group")!;
  const lbPos = dialog.querySelector<HTMLElement>(".qs-lb-pos")!;
  const shots = Array.from(document.querySelectorAll<HTMLButtonElement>(".qs-card"));
  let index = 0;

  function show(i: number, dir = 0) {
    index = (i + shots.length) % shots.length;
    const shot = shots[index];
    lbImg.src = shot.dataset.shotSrc ?? "";
    lbImg.alt = `${shot.dataset.shotGroup} ${shot.dataset.shotTitle} screenshot`;
    lbTitle.textContent = shot.dataset.shotTitle ?? "";
    lbGroup.textContent = shot.dataset.shotGroup ?? "";
    lbPos.textContent = `${String(index + 1).padStart(2, "0")} / ${String(shots.length).padStart(2, "0")}`;
    if (dir && motionOk()) {
      gsap.fromTo(lbImg, { x: 80 * dir, opacity: 0, scale: 0.96 }, { x: 0, opacity: 1, scale: 1, duration: 0.7, ease: "expo.out" });
    }
  }

  function close() {
    const done = () => {
      dialog.close();
      cursorInto(null);
      setScrollLocked(false);
    };
    if (!motionOk()) return done();
    gsap.to(dialog, { opacity: 0, duration: 0.3, ease: "power2.in", onComplete: done });
  }

  shots.forEach((shot, i) => {
    shot.addEventListener("click", () => {
      show(i);
      gsap.set(dialog, { opacity: 1 });
      setScrollLocked(true);
      dialog.showModal();
      cursorInto(dialog);
      if (motionOk()) {
        gsap.fromTo(dialog, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" });
        gsap.fromTo(lbImg, { scale: 0.86, y: 40, clipPath: "inset(8% 8% 8% 8% round 14px)" }, { scale: 1, y: 0, clipPath: "inset(0% 0% 0% 0% round 14px)", duration: 0.9, ease: "expo.out" });
      }
    });
  });

  dialog.querySelector(".qs-lb-close")!.addEventListener("click", close);
  dialog.querySelector(".qs-lb-prev")!.addEventListener("click", () => show(index - 1, -1));
  dialog.querySelector(".qs-lb-next")!.addEventListener("click", () => show(index + 1, 1));
  dialog.addEventListener("cancel", (e) => {
    e.preventDefault();
    close();
  });
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(index - 1, -1);
    else if (e.key === "ArrowRight") show(index + 1, 1);
  });
</script>
