---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GuideReference from "../components/GuideReference.astro";
import { Content as Guide, frontmatter, getHeadings } from "../docs/self-hosting.md";
import { GITHUB_URL, LICENSE_URL, RAW_REPO_URL, SELF_HOST_REPO_URL } from "../data/features";
import { SCREENSHOTS_PATH } from "../data/site";

const headings = getHeadings();

const modes = [
  { id: "lite", label: "Lite", profile: "selfhosted", env: ".env.selfhosted.example", pnpm: "docker:selfhosted" },
  { id: "full", label: "Full", profile: "selfhosted-full", env: ".env.selfhosted-full.example", pnpm: "docker:selfhosted-full" },
  { id: "prod", label: "Production", profile: "production", env: ".env.production.example", pnpm: "docker:prod" },
];
const lite = modes[0];

const modeTable = [
  { mode: "local", stack: "SQLite, no Redis", best: "Development on your machine", profile: "—" },
  { mode: "selfhosted", stack: "SQLite volume, inline sync", best: "Home server / small household", profile: "selfhosted" },
  { mode: "selfhosted-full", stack: "Postgres + Redis + queues", best: "Always-on self-host with more users", profile: "selfhosted-full" },
  { mode: "production", stack: "Same as full + public HTTPS checks", best: "Hardened public HTTPS / multi-user instance", profile: "production" },
];

type Part = string | { v: "profile" | "env" | "pnpm" };
type Line = { kind: "cmd" | "note"; parts: Part[] };
const cmd = (...parts: Part[]): Line => ({ kind: "cmd", parts });
const note = (text: string): Line => ({ kind: "note", parts: [text] });
const PROFILE = { v: "profile" } as const;
const ENV = { v: "env" } as const;
const PNPM = { v: "pnpm" } as const;

const sets = [
  {
    id: "source",
    label: "From source",
    title: "~/Questory · bash",
    blurb: "The documented path: clone the repo and build the images locally with --build.",
    lines: [
      cmd("git clone https://github.com/Questory-Labs/Questory.git"),
      cmd("cd Questory"),
      cmd("cp ", ENV, " .env"),
      note("# edit SESSION_SECRET, STEAM_API_KEY, URLs, optional ALLOWED_STEAM_IDS"),
      cmd("docker compose --profile ", PROFILE, " --env-file .env up -d --build"),
      note("# or, with Node + pnpm: pnpm docker:<mode> -- --build"),
    ],
  },
  {
    id: "prebuilt",
    label: "Prebuilt images",
    title: "~/questory · bash",
    blurb: "Optional: pull published images instead of building. Fetch the compose file and the env template for your stack.",
    lines: [
      cmd("mkdir questory && cd questory"),
      cmd(`curl -LO ${RAW_REPO_URL}docker-compose.yml`),
      cmd(`curl -LO ${RAW_REPO_URL}`, ENV),
      cmd("cp ", ENV, " .env"),
      note("# edit SESSION_SECRET, STEAM_API_KEY, URLs"),
      cmd("docker compose --profile ", PROFILE, " --env-file .env up -d"),
    ],
  },
];

const channels = [
  { channel: "stable", rolling: "stable, latest", pinned: "vX.Y.Z" },
  { channel: "rc", rolling: "rc", pinned: "vX.Y.Z-rc.N" },
  { channel: "canary", rolling: "canary", pinned: "vX.Y.Z-canary.N" },
];

const envVars = [
  { key: "APP_MODE", note: "required", html: "Boot mode: <code>local</code>, <code>selfhosted</code>, <code>selfhosted-full</code> or <code>production</code>." },
  { key: "SESSION_SECRET", note: "required", html: "Long random string, at least 16 characters. The API rejects weak placeholders outside local mode." },
  { key: "STEAM_API_KEY", note: "required", html: 'Your Steam Web API key from <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noopener noreferrer">steamcommunity.com/dev/apikey</a>.' },
  { key: "DATABASE_PROVIDER", note: "per mode", html: "<code>sqlite</code> for lite, <code>postgresql</code> for full and production. Pairs with <code>DATABASE_URL</code>." },
  { key: "REDIS_URL", note: "optional", html: "Shares cache and locks across processes and enables BullMQ sync queues. Leave empty for in-memory." },
];

const checks = [
  ["SESSION_SECRET", "Long random string; the API rejects weak placeholders in non-local modes"],
  ["STEAM_API_KEY", "Your Steam Web API key"],
  ["CRON_SECRET", "For /v1/internal/cron/* HTTP callers; optional if you only use in-process cron"],
  ["Music & watch tokens", "Mint per-user API keys in Settings, not env vars"],
  ["TRAKT_CLIENT_ID / TRAKT_CLIENT_SECRET", "Required for Trakt OAuth in the watch module"],
  ["TMDB_API_KEY", "Watch metadata enrichment; keep TMDB attribution in the UI"],
  ["Postgres password", "Change the compose default on any internet-facing host"],
  [".env stays private", "Never commit .env"],
];

const findHeading = (prefix: string) => headings.find((h) => h.depth <= 3 && h.text.startsWith(prefix));
const deeper = [
  { prefix: "Reverse proxy", title: "Reverse proxy", sub: "Same-origin setup and cookies" },
  { prefix: "QEngine security", title: "QEngine security", sub: "Internal network, secrets, Caddy" },
  { prefix: "Music analytics", title: "Music", sub: "Last.fm, multi-scrobbler, imports" },
  { prefix: "Watch analytics", title: "Watch", sub: "Trakt, AniList, webhooks" },
  { prefix: "qMonitor device login", title: "qMonitor", sub: "Device login and /api/health probe" },
  { prefix: "Optional: Read", title: "Read", sub: "Manga and print sources" },
  { prefix: "Steam OpenID URLs", title: "Steam OpenID", sub: "Realm and return URLs" },
  { prefix: "Auth (email", title: "Auth", sub: "Email + password, ADMIN_EMAILS" },
  { prefix: "Steam ID allowlist", title: "Steam ID allowlist", sub: "Who may link an account" },
  { prefix: "Feature flags", title: "Feature flags", sub: "Admin settings and /v1/status" },
  { prefix: "Backups", title: "Backups", sub: "SQLite and PostgreSQL" },
  { prefix: "Daily sync cron", title: "Daily sync cron", sub: "In-process or external" },
]
  .map((item) => ({ ...item, slug: findHeading(item.prefix)?.slug }))
  .filter((item): item is typeof item & { slug: string } => Boolean(item.slug));

const toc = [
  { id: "license", label: "License limits" },
  { id: "prerequisites", label: "Prerequisites" },
  { id: "deployment-modes", label: "Deployment modes" },
  { id: "quick-start", label: "Quick start" },
  { id: "images", label: "Images & channels" },
  { id: "after-starting", label: "After starting" },
  { id: "env", label: "The .env that matters" },
  { id: "secrets", label: "Secrets checklist" },
  { id: "updating", label: "Updating" },
  { id: "enterprise", label: "Enterprise · QEngine" },
  { id: "deeper", label: "Going deeper" },
  { id: "guide", label: "Full guide" },
];

const h2 = "m-0 text-[clamp(28px,3.2vw,38px)] font-light tracking-[-0.035em]";
const lede = "mb-0 mt-3 max-w-[620px] text-[var(--muted-strong)]";
---

<BaseLayout title={`${frontmatter.title} — Questory`} description={frontmatter.description}>
  <SiteHeader />
  <main class="mx-auto max-w-[1240px] px-4">
    <div class="docs-shell pt-[clamp(48px,7vw,96px)]">
      <aside class="docs-sidebar" aria-label="On this page">
        <p class="label-mono mb-4 mt-0">On this page</p>
        <nav class="q-toc" data-page-toc>
          <span class="q-toc-ind" aria-hidden="true"></span>
          <ul class="m-0 list-none p-0">
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ul>
        </nav>
        <a href={SELF_HOST_REPO_URL} target="_blank" rel="noopener noreferrer" class="q-btn q-btn-ghost q-btn-sm mt-6">Edit on GitHub</a>
      </aside>

      <div class="docs-main flex flex-col gap-[clamp(64px,8vw,104px)] pb-10">
        <section aria-labelledby="hero">
          <p class="q-eyebrow q-in" style="--i: 1">Docs — Self-hosting</p>
          <h1 id="hero" class="q-h1 q-in" style="--i: 2">Run Questory on <em class="font-serif text-[var(--muted-strong)]">your own box.</em></h1>
          <p class="q-lede q-in max-w-[600px]" style="--i: 3">
            From a home server on SQLite to a multi-user Postgres and Redis stack — same app, same compose file, one <code class="code-inline">.env</code>.
          </p>
        </section>

        <section id="license" aria-labelledby="license-h" class="q-accent q-reveal scroll-mt-24 p-[clamp(22px,3vw,32px)]">
          <p class="q-eyebrow !text-[var(--warm)]">Read first</p>
          <h2 id="license-h" class={h2}>License limits</h2>
          <p class={lede}>
            Questory is source-available under the
            <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" class="text-[var(--warm-ink)] underline underline-offset-4">PolyForm Noncommercial License 1.0.0</a>.
            Personal, hobby and other noncommercial use is allowed. Selling it or charging for hosted access is not — ask the copyright holder for a commercial license.
          </p>
          <p class="mb-0 mt-3 max-w-[620px] text-sm text-[var(--muted)]">If you redistribute it, include the license terms and any <code class="code-inline">Required Notice:</code> lines. It is not OSI open source.</p>
        </section>

        <section id="prerequisites" aria-labelledby="pre-h" class="scroll-mt-24">
          <h2 id="pre-h" class={h2}>Prerequisites</h2>
          <ul class="m-0 mt-5 grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))]">
            <li class="q-card p-5"><p class="label-mono m-0">Runtime</p><p class="mb-0 mt-2">Docker with Compose (<code class="code-inline">docker compose</code>)</p></li>
            <li class="q-card p-5"><p class="label-mono m-0">Steam</p><p class="mb-0 mt-2">A Steam Web API key</p></li>
            <li class="q-card p-5"><p class="label-mono m-0">Secret</p><p class="mb-0 mt-2"><code class="code-inline">SESSION_SECRET</code> of 16+ characters</p></li>
            <li class="q-card p-5"><p class="label-mono m-0">From source</p><p class="mb-0 mt-2">Git; Node + pnpm only for the <code class="code-inline">pnpm docker:*</code> shortcuts</p></li>
          </ul>
        </section>

        <section id="deployment-modes" aria-labelledby="modes-h" class="scroll-mt-24">
          <h2 id="modes-h" class={h2}>Deployment modes</h2>
          <p class={lede}>Set <code class="code-inline">APP_MODE</code> and pick the matching Compose profile and env template. The API always caches — in memory by default, shared through Redis when <code class="code-inline">REDIS_URL</code> is set.</p>
          <div class="q-g mt-6 overflow-x-auto">
            <table class="w-full min-w-[560px] border-collapse text-left text-sm">
              <thead>
                <tr class="label-mono">
                  <th class="px-5 py-3.5 font-normal">APP_MODE</th>
                  <th class="px-5 py-3.5 font-normal">Stack</th>
                  <th class="px-5 py-3.5 font-normal">Best for</th>
                  <th class="px-5 py-3.5 font-normal">Profile</th>
                </tr>
              </thead>
              <tbody>
                {
                  modeTable.map((m) => (
                    <tr class="border-t border-[var(--line)]">
                      <td class="px-5 py-3.5 font-mono text-[13px]">{m.mode}</td>
                      <td class="px-5 py-3.5 text-[var(--muted-strong)]">{m.stack}</td>
                      <td class="px-5 py-3.5 text-[var(--muted)]">{m.best}</td>
                      <td class="px-5 py-3.5 font-mono text-[13px] text-[var(--muted)]">{m.profile}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section id="quick-start" aria-labelledby="qs-h" class="scroll-mt-24">
          <h2 id="qs-h" class={h2}>Quick start</h2>
          <p class={lede}>Build from the repo with <code class="code-inline">--build</code>. Prebuilt images are optional. Every command below follows the stack you pick.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <div class="q-seg" role="group" aria-label="Stack">
              {modes.map((m) => <button type="button" data-mode={m.id} data-profile={m.profile} data-env={m.env} data-pnpm={m.pnpm} aria-pressed={m.id === lite.id ? "true" : "false"}>{m.label}</button>)}
            </div>
            <div class="q-seg" role="group" aria-label="Install method">
              {sets.map((s, i) => <button type="button" data-source={s.id} aria-pressed={i === 0 ? "true" : "false"}>{s.label}</button>)}
            </div>
          </div>
          {
            sets.map((s, si) => (
              <div data-set={s.id} hidden={si !== 0} class="mt-4">
                <p class="mb-3 mt-0 text-sm text-[var(--muted)]">{s.blurb}</p>
                <div data-copy-scope class="q-term overflow-hidden">
                  <div class="flex items-center justify-between gap-3 border-b border-[rgba(255,255,255,0.06)] py-2 pl-4 pr-2">
                    <span class="flex items-center gap-2 font-mono text-xs text-[var(--faint)]">
                      <span class="dot q-live text-[var(--ok)]" aria-hidden="true"></span>
                      {s.title}
                    </span>
                    <button type="button" data-copy class="q-btn q-btn-ghost q-btn-sm" aria-label={`Copy ${s.label} commands`}><span class="q-copy-label" aria-live="polite">Copy</span></button>
                  </div>
                  <div class="q-code px-5 py-4 text-[13px] leading-[1.9]">
                    {s.lines.map((line) => (
                      <div class:list={[line.kind === "note" && "text-[var(--faint)]"]}>
                        {line.kind === "cmd" && <span class="text-[var(--faint)]" aria-hidden="true">$ </span>}
                        <span class:list={[line.kind === "cmd" && "q-copy-text"]}>
                          {line.parts.map((part) => (typeof part === "string" ? part : <span data-var={part.v}>{lite[part.v]}</span>))}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
          <p class="mb-0 mt-4 text-sm text-[var(--muted)]">
            pnpm shortcut for your pick: <code class="code-inline">pnpm <span data-var="pnpm">{lite.pnpm}</span> -- --build</code>
          </p>
        </section>

        <section id="images" aria-labelledby="img-h" class="scroll-mt-24">
          <h2 id="img-h" class={h2}>Images & release channels</h2>
          <p class={lede}>
            Compose pulls from Docker Hub by default. Set <code class="code-inline">DOCKERHUB_NAMESPACE</code> to use your own namespace and <code class="code-inline">IMAGE_TAG</code> to follow a channel or pin a build.
          </p>
          <div class="mt-6 flex flex-col gap-2.5">
            {
              ["API", "Web"].map((name) => (
                <div data-copy-scope class="q-row flex flex-wrap items-center gap-x-5 gap-y-2 rounded-[18px] border border-[var(--line)] px-5 py-3.5">
                  <span class="w-14 flex-none">{name}</span>
                  <code class="q-copy-text min-w-0 flex-1 break-all font-mono text-[13px] text-[var(--muted-strong)]">{`\${DOCKERHUB_NAMESPACE:-santoshpanna}/questorylabs-${name.toLowerCase()}:\${IMAGE_TAG:-latest}`}</code>
                  <button type="button" data-copy class="q-btn q-btn-ghost q-btn-sm" aria-label={`Copy ${name} image reference`}><span class="q-copy-label">Copy</span></button>
                </div>
              ))
            }
          </div>
          <div class="q-g mt-4 overflow-x-auto">
            <table class="w-full min-w-[460px] border-collapse text-left text-sm">
              <thead>
                <tr class="label-mono">
                  <th class="px-5 py-3.5 font-normal">Channel</th>
                  <th class="px-5 py-3.5 font-normal">Rolling tag</th>
                  <th class="px-5 py-3.5 font-normal">Pin exact build</th>
                </tr>
              </thead>
              <tbody>
                {
                  channels.map((c) => (
                    <tr class="border-t border-[var(--line)]">
                      <td class="px-5 py-3.5">{c.channel}</td>
                      <td class="px-5 py-3.5 font-mono text-[13px] text-[var(--muted-strong)]">{c.rolling}</td>
                      <td class="px-5 py-3.5 font-mono text-[13px] text-[var(--muted)]">{c.pinned}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="mb-0 mt-4 max-w-[680px] text-sm text-[var(--muted)]">
            <code class="code-inline">:latest</code> tracks stable. Compose defaults to <code class="code-inline">PULL_POLICY=always</code>, so rolling tags update on <code class="code-inline">docker compose up</code>; set <code class="code-inline">PULL_POLICY=missing</code> when you pin an exact version. QEngine has no public image — see <a href="#enterprise" class="text-[var(--ink)] underline underline-offset-4">Enterprise</a>.
          </p>
        </section>

        <section id="after-starting" aria-labelledby="as-h" class="scroll-mt-24">
          <h2 id="as-h" class={h2}>After starting</h2>
          <div class="mt-6 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))]">
            <div class="q-card p-5"><p class="label-mono m-0">Web UI</p><p class="mb-0 mt-3 font-mono text-lg">localhost:3000</p><p class="mb-0 mt-2 text-sm text-[var(--muted)]">Or your <code class="code-inline">WEB_ORIGIN</code></p></div>
            <div class="q-card p-5"><p class="label-mono m-0">API</p><p class="mb-0 mt-3 font-mono text-lg">localhost:4000</p><p class="mb-0 mt-2 text-sm text-[var(--muted)]">Or your public API URL</p></div>
            <div class="q-card p-5"><p class="label-mono m-0">Liveness</p><p class="mb-0 mt-3 font-mono text-lg">GET /health</p><p class="mb-0 mt-2 text-sm text-[var(--muted)]">Returns <code class="code-inline">ok</code> and <code class="code-inline">service</code> only</p></div>
            <div class="q-card p-5"><p class="label-mono m-0">Feature flags</p><p class="mb-0 mt-3 font-mono text-lg">GET /v1/status</p><p class="mb-0 mt-2 text-sm text-[var(--muted)]">Plus Admin → Settings</p></div>
          </div>
          <p class="mb-0 mt-4 max-w-[680px] text-sm text-[var(--muted)]">
            <code class="code-inline">NEXT_PUBLIC_API_URL</code> is read when the web container starts (written into <code class="code-inline">/runtime-env.js</code>), so Hub-pulled images honour the compose environment without a rebuild.
          </p>
        </section>

        <section id="env" aria-labelledby="env-h" class="scroll-mt-24">
          <h2 id="env-h" class={h2}>The .env that matters</h2>
          <p class={lede}>Five variables decide the stack. The templates carry the rest, including <code class="code-inline">WEB_ORIGIN</code>, Steam OpenID URLs and the optional modules.</p>
          <div class="mt-6 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))]">
            {
              envVars.map((v) => (
                <div class="q-feat rounded-[24px] border border-[rgba(255,255,255,0.06)] p-5">
                  <p class="m-0 flex flex-wrap items-center justify-between gap-2">
                    <code class="font-mono text-[15px]">{v.key}</code>
                    <span class="label-mono">{v.note}</span>
                  </p>
                  <p class="mb-0 mt-2.5 text-sm text-[var(--muted)] [&_a]:text-[var(--ink)] [&_a]:underline [&_a]:underline-offset-[3px] [&_code]:font-mono [&_code]:text-[var(--ink)]" set:html={v.html} />
                </div>
              ))
            }
          </div>
        </section>

        <section id="secrets" aria-labelledby="sec-h" class="scroll-mt-24">
          <h2 id="sec-h" class={h2}>Secrets checklist</h2>
          <div class="mt-5 flex items-center gap-4">
            <div class="tick-track h-3 flex-1 overflow-hidden rounded-sm"><div class="tick-fill" data-tick style="width: 0%"></div></div>
            <span class="font-mono text-sm text-[var(--muted)]" aria-live="polite"><span data-done>0</span> / {checks.length}</span>
          </div>
          <div class="mt-4 flex flex-col gap-2">
            {
              checks.map(([key, desc]) => (
                <label class="q-check">
                  <input type="checkbox" data-check />
                  <span class="q-box">
                    <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--bg-0)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg>
                  </span>
                  <span class="min-w-0">
                    <code class="block break-all font-mono text-sm">{key}</code>
                    <span class="mt-1 block text-sm text-[var(--muted)]">{desc}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </section>

        <section id="updating" aria-labelledby="up-h" class="scroll-mt-24">
          <h2 id="up-h" class={h2}>Updating</h2>
          <p class={lede}>Back up your database first. Containers run <code class="code-inline">prisma db push</code> on start against the shared schema.</p>
          <div class="q-term mt-5 px-5 py-4">
            <div class="q-code text-[13px] leading-[1.9]">
              <div class="text-[var(--faint)]"># prebuilt: refresh the compose file — a new image with an old one is unsupported</div>
              <div><span class="text-[var(--faint)]">$ </span>curl -LO {RAW_REPO_URL}docker-compose.yml</div>
              <div><span class="text-[var(--faint)]">$ </span>docker compose --profile <span data-var="profile">{lite.profile}</span> --env-file .env up -d</div>
              <div class="text-[var(--faint)]"># from source</div>
              <div><span class="text-[var(--faint)]">$ </span>git pull</div>
              <div><span class="text-[var(--faint)]">$ </span>docker compose --profile <span data-var="profile">{lite.profile}</span> --env-file .env up -d --build</div>
            </div>
          </div>
        </section>

        <section id="enterprise" aria-labelledby="ent-h" class="q-accent q-reveal scroll-mt-24 flex flex-wrap items-center gap-8 p-[clamp(22px,3vw,36px)]">
          <canvas data-fingerprint width="280" height="280" aria-hidden="true" class="h-auto w-[220px] max-w-full flex-none rounded-[20px] bg-[rgba(0,0,0,0.35)]"></canvas>
          <div class="min-w-0 flex-[1_1_320px]">
            <p class="q-eyebrow !text-[var(--warm)]">Enterprise · opt-in</p>
            <h2 id="ent-h" class={h2}>QEngine <em class="font-serif text-[var(--warm-ink)]">stack</em></h2>
            <p class={lede}>
              Recommendations and the taste fingerprint run in a separate Rust service, switched on with <code class="code-inline">ENTERPRISE=true</code> via <code class="code-inline">docker-compose.enterprise.yml</code> and <code class="code-inline">.env.enterprise.example</code>.
              Its images ship from the private repo only — binary-only, personal / noncommercial license.
            </p>
            <ul class="mb-0 mt-4 flex list-none flex-col gap-2 p-0 text-sm text-[var(--muted-strong)]">
              <li>Browser traffic goes through the API; QEngine stays on the internal Docker network.</li>
              <li>Set the same long <code class="code-inline">ENTERPRISE_INTERNAL_SECRET</code> in the API and QEngine.</li>
              <li>Don't publish the OTEL ports <code class="code-inline">:4040</code> / <code class="code-inline">:4318</code> to the host.</li>
            </ul>
            {findHeading("QEngine security") && <a href={`#${findHeading("QEngine security")!.slug}`} class="mt-4 inline-flex text-sm text-[var(--warm-ink)] underline-offset-4 hover:underline">QEngine security in the guide ↓</a>}
          </div>
        </section>

        <section id="deeper" aria-labelledby="deep-h" class="scroll-mt-24">
          <h2 id="deep-h" class={h2}>Going deeper</h2>
          <div class="mt-6 grid gap-2.5 [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))]">
            {
              deeper.map((item) => (
                <a href={`#${item.slug}`} class="q-row flex items-center justify-between gap-3 rounded-[18px] border border-[var(--line)] px-5 py-4">
                  <span>
                    <span class="block">{item.title}</span>
                    <span class="mt-0.5 block text-sm text-[var(--muted)]">{item.sub}</span>
                  </span>
                  <span aria-hidden="true" class="text-[var(--muted-strong)]">↓</span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>

    <section id="guide" aria-labelledby="guide-h" class="scroll-mt-24 border-t border-[var(--line)] pt-[clamp(56px,7vw,96px)]">
      <p class="q-eyebrow">The full guide</p>
      <h2 id="guide-h" class="q-h2">{frontmatter.title}</h2>
      <p class="q-lede max-w-[720px]">{frontmatter.description}</p>
      <div class="mt-10">
        <GuideReference headings={headings}>
          <Guide />
        </GuideReference>
      </div>
    </section>

    <section aria-labelledby="end" class="px-4 pb-20 pt-[clamp(96px,12vw,140px)] text-center">
      <h2 id="end" class="q-reveal m-0 text-[clamp(40px,6vw,88px)] font-light leading-none tracking-[-0.05em]">Your box.<br /><em class="font-serif text-[var(--muted-strong)]">Your stories.</em></h2>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="q-btn q-btn-primary">Get Questory</a>
        <a href={SCREENSHOTS_PATH} class="q-btn q-btn-ghost">Browse screenshots</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { initCopy, initReveal, initToc, animateWhileVisible, paintFingerprint } from "../scripts/motion";

  initReveal();
  initCopy();

  const pageToc = document.querySelector<HTMLElement>("[data-page-toc]");
  if (pageToc) initToc(pageToc);

  const fp = document.querySelector<HTMLCanvasElement>("canvas[data-fingerprint]");
  if (fp) animateWhileVisible(fp, (t) => paintFingerprint(fp, t));

  const setVar = (name: string, value: string) => {
    document.querySelectorAll<HTMLElement>(`[data-var="${name}"]`).forEach((el) => (el.textContent = value));
  };
  const pressOnly = (buttons: NodeListOf<HTMLButtonElement>, active: HTMLButtonElement) =>
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === active)));

  const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-mode]");
  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      pressOnly(modeButtons, button);
      const { profile = "", env = "", pnpm = "" } = button.dataset;
      setVar("profile", profile);
      setVar("env", env);
      setVar("pnpm", pnpm);
    });
  });

  const sourceButtons = document.querySelectorAll<HTMLButtonElement>("[data-source]");
  sourceButtons.forEach((button) => {
    button.addEventListener("click", () => {
      pressOnly(sourceButtons, button);
      document.querySelectorAll<HTMLElement>("[data-set]").forEach((set) => {
        set.hidden = set.dataset.set !== button.dataset.source;
      });
    });
  });

  const boxes = document.querySelectorAll<HTMLInputElement>("[data-check]");
  const done = document.querySelector("[data-done]");
  const tick = document.querySelector<HTMLElement>("[data-tick]");
  boxes.forEach((box) => {
    box.addEventListener("change", () => {
      const count = Array.from(boxes).filter((b) => b.checked).length;
      if (done) done.textContent = String(count);
      if (tick) tick.style.width = `${Math.round((count / boxes.length) * 100)}%`;
    });
  });
</script>
